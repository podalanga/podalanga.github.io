---
import { ClientRouter } from 'astro:transitions';
import { site } from '../config/site';
import { getImage } from 'astro:assets';
import portrait from '../assets/profile/portrait.jpg';
import { absoluteUrl, personNode, websiteNode } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EyeLoader from '../components/EyeLoader.astro';
import Terminal from '../components/Terminal.astro';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

// A stable, square-ish rendition of the portrait for Person.image (knowledge panels, AI answers).
const portraitCard = await getImage({ src: portrait, width: 800, format: 'jpg' });

interface Props {
  title?: string;
  description?: string;
  /** og:type. Blog posts are articles, the home page is a profile. */
  type?: 'website' | 'article' | 'profile';
  /** Absolute URL of a page-specific social card; falls back to /og.png. */
  image?: string;
  imageAlt?: string;
  /** Extra JSON-LD nodes for this page, merged into the site-wide @graph. */
  jsonLd?: Record<string, unknown>[];
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Keep thin or utility pages (tag listings, 404) out of the index but let links be followed. */
  noindex?: boolean;
  keywords?: readonly string[];
}

const {
  title = site.title,
  description = site.description,
  type = 'website',
  image,
  imageAlt = `${site.person.name} (${site.name}), robotics and control-systems engineer`,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  noindex = false,
  keywords = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const ogImage = image ?? new URL('/og.png', site.url).href;
const isHome = Astro.url.pathname === '/';
const metaKeywords = [...new Set([site.person.name, site.name, ...keywords, ...site.keywords])].join(', ');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [websiteNode(), personNode(absoluteUrl(portraitCard.src)), ...jsonLd],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={monoLatin} crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.person.name} />
    <meta name="keywords" content={metaKeywords} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="alternate" type="application/rss+xml" title={`${site.person.name} · Blog`} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="author" href="/llms.txt" type="text/plain" />
    <link rel="me" href={site.socials.github} />
    <link rel="me" href={site.socials.linkedin} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${site.name} · ${site.person.name}`} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:url" content={canonical} />
    {type === 'profile' && <meta property="profile:first_name" content={site.person.givenName} />}
    {type === 'profile' && <meta property="profile:username" content={site.name.toLowerCase()} />}
    {type === 'article' && <meta property="article:author" content={`${site.url}/`} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />

    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var stored = localStorage.getItem('pdl:theme');
            var theme =
              stored === 'light' || stored === 'dark'
                ? stored
                : window.matchMedia('(prefers-color-scheme: light)').matches
                  ? 'light'
                  : 'dark';
            document.documentElement.dataset.theme = theme;
          } catch (e) {
            document.documentElement.dataset.theme = 'dark';
          }
        }

        applyTheme();

        // A soft navigation swaps in the incoming document's <html>, which carries no
        // data-theme (the attribute only ever exists because this script set it). Without
        // this the attribute is dropped on every in-site link and the page falls back to
        // the dark default — invisible to dark users, but it threw light users back to
        // dark on every click. astro:after-swap runs before paint, so there's no flash.
        // This script is is:inline and does not re-run on swap, but the listener persists.
        document.addEventListener('astro:after-swap', applyTheme);

        document.documentElement.classList.add('eye-pending');
      })();
    </script>
    <noscript>
      <style>
        html.eye-pending {
          overflow: revert !important;
        }
        #eye-loader {
          display: none !important;
        }
      </style>
    </noscript>

    <ClientRouter />
  </head>
  <body>
    <EyeLoader isHome={isHome} />
    <div class="grain"></div>
    <div class="scanlines"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Terminal />
    <script>
      import { initPageGlitch } from '../effects/page-glitch';
      import { initScramble } from '../effects/scramble';
      import { initThemeWipe } from '../effects/theme-wipe';
      import { initRedacted } from '../effects/redact';
      import { initTelemetry } from '../effects/telemetry';
      import { initHeaderClock } from '../effects/header-clock';
      import { initSecurityCamera } from '../effects/security-camera';
      import { initTerminal } from '../effects/terminal/terminal';
      import { initSectionIndex } from '../effects/section-index';
      import { initKonami } from '../effects/konami';
      import { initConsoleSigil } from '../effects/console-sigil';

      // page-glitch, konami and the console sigil don't touch per-page DOM (or only ever touch
      // `document`, which persists across soft navs); this script itself doesn't re-execute on
      // navigation, so setting these up once here is enough for the whole session.
      initPageGlitch();
      initKonami();
      initConsoleSigil();

      // Everything else touches DOM nodes that get recreated on every soft nav, so it's
      // re-initialized each `astro:page-load` and torn down on the following `astro:before-swap`
      // (each effect exports init() -> destroy()).
      let destroy: (() => void) | undefined;
      document.addEventListener('astro:page-load', () => {
        const teardowns = [
          initThemeWipe(),
          initScramble(),
          initRedacted(),
          initTelemetry(),
          initHeaderClock(),
          initSecurityCamera(),
          initTerminal(),
          initSectionIndex(),
        ];
        destroy = () => teardowns.forEach((fn) => fn());
      });
      document.addEventListener('astro:before-swap', () => destroy?.());
    </script>
  </body>
</html>
