---
import { ClientRouter } from 'astro:transitions';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EyeLoader from '../components/EyeLoader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const ogImage = new URL('/og.png', site.url);
const isHome = Astro.url.pathname === '/';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Joshua John L',
  alternateName: site.name,
  url: site.url,
  sameAs: [site.socials.github, site.socials.linkedin],
  jobTitle: 'Robotics & Control Systems Engineer',
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('pdl:theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
        document.documentElement.classList.add('eye-pending');
      })();
    </script>
    <noscript>
      <style>
        html.eye-pending body > *:not(#eye-loader) {
          display: revert !important;
        }
        #eye-loader {
          display: none !important;
        }
      </style>
    </noscript>

    {isHome && <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />}

    <ClientRouter />
  </head>
  <body>
    <EyeLoader />
    <div class="grain"></div>
    <div class="scanlines"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { initPageGlitch } from '../effects/page-glitch';
      import { initScramble } from '../effects/scramble';
      import { initThemeWipe } from '../effects/theme-wipe';

      // page-glitch owns a single `astro:before-swap` listener for the whole session — it isn't
      // tied to per-page DOM, so it's set up once rather than on every astro:page-load.
      initPageGlitch();

      // theme-wipe (button) and scramble ([data-scramble] elements) touch DOM nodes that get
      // recreated on every soft nav, so they're re-initialized each `astro:page-load` and torn
      // down on the following `astro:before-swap` (each effect exports init() -> destroy()).
      let destroy: (() => void) | undefined;
      document.addEventListener('astro:page-load', () => {
        const destroyThemeWipe = initThemeWipe();
        const destroyScramble = initScramble();
        destroy = () => {
          destroyThemeWipe();
          destroyScramble();
        };
      });
      document.addEventListener('astro:before-swap', () => destroy?.());
    </script>
  </body>
</html>
