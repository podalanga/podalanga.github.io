---
import { ClientRouter } from 'astro:transitions';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EyeLoader from '../components/EyeLoader.astro';
import Terminal from '../components/Terminal.astro';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const ogImage = new URL('/og.png', site.url);
const isHome = Astro.url.pathname === '/';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Joshua John L',
  alternateName: site.name,
  url: site.url,
  sameAs: [site.socials.github, site.socials.linkedin],
  jobTitle: 'Robotics & Control Systems Engineer',
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={monoLatin} crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('pdl:theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
        document.documentElement.classList.add('eye-pending');
      })();
    </script>
    <noscript>
      <style>
        html.eye-pending body > *:not(#eye-loader) {
          display: revert !important;
        }
        #eye-loader {
          display: none !important;
        }
      </style>
    </noscript>

    {isHome && <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />}

    <ClientRouter />
  </head>
  <body>
    <EyeLoader isHome={isHome} />
    <div class="grain"></div>
    <div class="scanlines"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Terminal />
    <script>
      import { initPageGlitch } from '../effects/page-glitch';
      import { initScramble } from '../effects/scramble';
      import { initThemeWipe } from '../effects/theme-wipe';
      import { initRedacted } from '../effects/redact';
      import { initTelemetry } from '../effects/telemetry';
      import { initHeaderClock } from '../effects/header-clock';
      import { initSecurityCamera } from '../effects/security-camera';
      import { initTerminal } from '../effects/terminal/terminal';
      import { initSectionIndex } from '../effects/section-index';
      import { initKonami } from '../effects/konami';
      import { initConsoleSigil } from '../effects/console-sigil';

      // page-glitch, konami and the console sigil don't touch per-page DOM (or only ever touch
      // `document`, which persists across soft navs); this script itself doesn't re-execute on
      // navigation, so setting these up once here is enough for the whole session.
      initPageGlitch();
      initKonami();
      initConsoleSigil();

      // Everything else touches DOM nodes that get recreated on every soft nav, so it's
      // re-initialized each `astro:page-load` and torn down on the following `astro:before-swap`
      // (each effect exports init() -> destroy()).
      let destroy: (() => void) | undefined;
      document.addEventListener('astro:page-load', () => {
        const teardowns = [
          initThemeWipe(),
          initScramble(),
          initRedacted(),
          initTelemetry(),
          initHeaderClock(),
          initSecurityCamera(),
          initTerminal(),
          initSectionIndex(),
        ];
        destroy = () => teardowns.forEach((fn) => fn());
      });
      document.addEventListener('astro:before-swap', () => destroy?.());
    </script>
  </body>
</html>
