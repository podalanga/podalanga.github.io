---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout>
  <section class="hero container">
    <p class="label">§ 00 — INDEX</p>
    <h1 class="headline">{site.tagline}</h1>
    <p class="sub mono">CONTROL · ROBOTICS · SIMULATION — NIT TRICHY / EPFL</p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 48ch;
  }

  .headline {
    font-size: var(--text-2xl);
  }

  .sub {
    color: var(--fg-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }
</style>
