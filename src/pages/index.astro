---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseFileCard from '../components/CaseFileCard.astro';
import ContactEmail from '../components/ContactEmail.astro';
import Logo from '../components/Logo.astro';
import Telemetry from '../components/Telemetry.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import portrait from '../assets/profile/portrait.jpg';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.start.getTime() - a.data.start.getTime()
);
const internships = works.filter((w) => w.data.kind === 'internship');
const projects = works.filter((w) => w.data.kind !== 'internship');

const education = (await getCollection('education')).sort((a, b) => a.data.order - b.data.order);
const skillGroups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="hero band band--lead" data-section="00" data-section-label="INDEX">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="label">§ 00 // INDEX</p>
        <Logo size="hero" text="Joshua John" />
        <h1 class="headline" data-scramble={site.tagline}>{site.tagline}</h1>
        <p class="sub mono">CONTROL · ROBOTICS · SIMULATION // NIT TRICHY / IIT MADRAS / EPFL</p>
        <p class="clearance mono">
          FOR BROTHERHOOD? WHY DON'T YOU TRY USING THE <span
            class="terminal-cue mono"
            role="button"
            tabindex="0"
            aria-label="Unauthorised terminal, by pressing ` or clicking here. Opens the terminal."
            data-terminal-open
          >UNAUTHORISED TERMINAL, BY PRESSING ` OR CLICKING HERE.</span> THOUGHTCRIME IS DEATH.
        </p>
        <Telemetry />
      </div>
      <div class="hero-portrait">
        <Image src={portrait} alt="Joshua John L" widths={[320, 480, 640, 900]} sizes="(min-width: 900px) 34vw, 60vw" />
      </div>
    </div>

    <a class="scroll-cue mono" href="#education">
      <span class="scroll-cue-rule" aria-hidden="true"></span>
      <span>SCROLL — § 01 EDUCATION</span>
    </a>
  </section>

  <section class="band" id="education" data-section="01" data-section-label="EDUCATION">
    <div class="container section-grid">
      <div class="rail">
        <p class="rail-no mono">§ 01</p>
        <h2 class="rail-label">Education</h2>
      </div>
      <div class="body">
        <div class="dossier-grid">
          {
            education.map((e) => (
              <article class="dossier-entry">
                <p class="org">{e.data.institution}</p>
                <p class="degree">{e.data.degree}</p>
                <p class="meta mono">{e.data.location} · {e.data.start} to {e.data.end} · {e.data.detail}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="band band--sunken" data-section="02" data-section-label="INTERNSHIPS">
    <div class="container section-grid">
      <div class="rail">
        <p class="rail-no mono">§ 02</p>
        <h2 class="rail-label">Internships</h2>
        <a class="view-all mono" href="/profile">ALL CASE FILES →</a>
      </div>
      <div class="body">
        <div class="case-grid">
          {
            internships.map((work, i) => (
              <CaseFileCard
                variant={i === 0 ? 'grid' : 'feature'}
                slug={work.id}
                fileNo={work.data.fileNo}
                codename={work.data.codename}
                title={work.data.title}
                org={work.data.org}
                start={work.data.start}
                end={work.data.end}
                status={work.data.status}
                kind={work.data.kind}
                summary={work.data.summary}
                tags={work.data.tags}
                cover={work.data.cover}
                coverAlt={work.data.coverAlt}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="band" data-section="03" data-section-label="PROJECTS">
    <div class="container section-grid">
      <div class="rail">
        <p class="rail-no mono">§ 03</p>
        <h2 class="rail-label">Projects</h2>
        <a class="view-all mono" href="/profile">ALL CASE FILES →</a>
      </div>
      <div class="body">
        <div class="case-grid">
          {
            projects.map((work, i) => (
              <CaseFileCard
                variant={i === 0 ? 'grid' : 'feature'}
                slug={work.id}
                fileNo={work.data.fileNo}
                codename={work.data.codename}
                title={work.data.title}
                org={work.data.org}
                start={work.data.start}
                end={work.data.end}
                status={work.data.status}
                kind={work.data.kind}
                summary={work.data.summary}
                tags={work.data.tags}
                cover={work.data.cover}
                coverAlt={work.data.coverAlt}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="band band--sunken" data-section="04" data-section-label="SKILLS">
    <div class="container section-grid">
      <div class="rail">
        <p class="rail-no mono">§ 04</p>
        <h2 class="rail-label">Skills</h2>
      </div>
      <div class="body">
        <div class="skills-grid">
          {
            skillGroups.map((g) => (
              <div class="skill-group">
                <p class="group-label mono">{g.data.label}</p>
                <ul class="mono">
                  {g.data.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="band contact" data-section="05" data-section-label="CONTACT">
    <div class="container section-grid">
      <div class="rail">
        <p class="rail-no mono">§ 05</p>
        <h2 class="rail-label">Contact</h2>
      </div>
      <div class="body">
        <p class="contact-lead">Open to robotics and control-systems work. The fastest route is email.</p>
        <ul class="contact-list">
          <li>
            <span class="contact-key mono">EMAIL</span>
            <ContactEmail />
          </li>
          <li>
            <span class="contact-key mono">GITHUB</span>
            <a href={site.socials.github} rel="me noopener noreferrer" target="_blank">github.com/podalanga</a>
          </li>
          <li>
            <span class="contact-key mono">LINKEDIN</span>
            <a href={site.socials.linkedin} rel="me noopener noreferrer" target="_blank">in/joshuajohnl</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */

  .hero-inner {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-6);
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    flex: 1;
    min-width: 0;
  }

  .hero-portrait {
    position: relative;
    align-self: center;
    width: min(60vw, 320px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
    filter: saturate(0.85) sepia(0.08);
    transition: filter var(--dur-slow) var(--ease-out);
  }

  .hero-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (hover: hover) {
    .hero-portrait:hover {
      filter: none;
    }
  }

  @media (min-width: 780px) {
    .hero-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-8);
    }

    .hero-portrait {
      width: 32%;
      align-self: stretch;
      aspect-ratio: auto;
    }
  }

  /* The hero is the whole first screen. Rather than centring a fixed-height block
     in a growing box -- which leaves the wordmark marooned in dead space on a large
     display -- the inner row stretches to the full height: the portrait fills it,
     and the text column centres itself against that. */
  @media (min-width: 900px) {
    .hero {
      position: relative;
      display: flex;
      align-items: stretch;
      min-height: calc(100svh - var(--header-h));
      padding-bottom: var(--space-9);

      /* The global type scale keys off viewport WIDTH only. On a wide-but-short
         laptop (1366x768) that makes the wordmark 235px tall on its own and pushes
         the hero past the one screen it is supposed to be. Re-cap the two display
         steps by height as well, scoped to the hero. Logo and the headline read
         these tokens, so nothing else needs to know. */
      --text-3xl: min(clamp(3.2rem, 1.8rem + 6.5vw, 7.5rem), 13vh);
      --text-2xl: min(clamp(2.6rem, 1.8rem + 3.6vw, 4.6rem), 7.4vh);
    }

    .hero-inner {
      width: 100%;
      align-items: stretch;
    }

    .hero-text {
      justify-content: center;
      flex: 0 1 auto;
      max-width: 52rem;
    }

    /* Taken out of flow so the photo fills whatever height the row ends up being,
       instead of its own intrinsic size dictating that height. */
    .hero-portrait {
      width: 36%;
      max-width: 42rem;
      aspect-ratio: auto;
      min-height: 0;
    }

    .hero-portrait :global(img) {
      position: absolute;
      inset: 0;
    }
  }

  /* Short laptop screens: trim the hero's own padding and rhythm so it still fits. */
  @media (min-width: 900px) and (max-height: 900px) {
    .hero {
      padding-block: var(--space-6) var(--space-7);
    }

    .hero-text {
      gap: var(--space-4);
    }
  }

  /* Tells people there is more below, and doubles as a real link to it. */
  .scroll-cue {
    display: none;
  }

  @media (min-width: 900px) {
    .scroll-cue {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      bottom: var(--space-6);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-wider);
      color: var(--fg-subtle);
      text-decoration: none;
      transition: color var(--dur) var(--ease-out);
    }

    .scroll-cue:hover,
    .scroll-cue:focus-visible {
      color: var(--signal);
    }

    /* A line that falls, once every few seconds: the smallest thing that reads as
       "down" without an arrow glyph bolted onto the label. */
    .scroll-cue-rule {
      width: 1px;
      height: var(--space-6);
      background: linear-gradient(to bottom, transparent, var(--line-strong));
      overflow: hidden;
      position: relative;
    }

    .scroll-cue-rule::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      top: 0;
      height: 45%;
      background: var(--signal);
      animation: scroll-cue-fall 2.6s var(--ease-in-out) infinite;
    }

    .scroll-cue:hover .scroll-cue-rule {
      background: linear-gradient(to bottom, transparent, var(--signal));
    }
  }

  @keyframes scroll-cue-fall {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    35%,
    65% {
      opacity: 1;
    }
    100% {
      transform: translateY(222%);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue-rule::after {
      animation: none;
      top: auto;
      bottom: 0;
    }
  }

  .headline {
    font-size: var(--text-2xl);
    max-width: 16ch;
  }

  .sub {
    color: var(--fg-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
  }

  /* The cryptic layer earns its place by being quiet: set at reading size with
     generous leading, it reads as a marginal note rather than a warning label. */
  .clearance {
    max-width: var(--measure-narrow);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    letter-spacing: var(--tracking-wider);
    color: var(--fg-subtle);
  }

  .terminal-cue {
    display: inline;
    color: var(--signal);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--signal-dim);
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .terminal-cue:hover,
  .terminal-cue:focus-visible {
    text-decoration-color: var(--signal);
  }

  /* ---- Margin index ---- */

  .rail-no {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--signal);
  }

  .rail-label {
    font-size: var(--text-lg);
  }

  .view-all {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .view-all:hover {
    color: var(--signal);
  }

  /* ---- Section bodies ---- */

  /* Asymmetric by design: the most recent file leads at full width, the rest
     sit in a two-up beneath it. */
  .case-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  @media (min-width: 900px) {
    .case-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-grid > :global(:first-child) {
      grid-column: 1 / -1;
    }
  }

  .dossier-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 900px) {
    .dossier-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  .dossier-entry {
    padding-left: var(--space-4);
    border-left: 1px solid var(--line);
  }

  .dossier-entry .org {
    font-size: var(--text-md);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--stretch-display);
    font-weight: 800;
    line-height: var(--leading-snug);
  }

  .dossier-entry .degree {
    color: var(--fg-muted);
    margin-top: var(--space-1);
  }

  .dossier-entry .meta {
    color: var(--fg-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-2);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-6) var(--space-5);
  }

  .group-label {
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--fg);
  }

  .skill-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /* ---- Contact ---- */

  .contact-lead {
    max-width: var(--measure);
    color: var(--fg-muted);
  }

  .contact-list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .contact-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: var(--text-md);
  }

  .contact-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .contact-key {
    flex: 0 0 6rem;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--fg-subtle);
  }

  .contact-list a {
    text-decoration: none;
  }

  .contact-list a:hover {
    color: var(--signal);
  }
</style>
