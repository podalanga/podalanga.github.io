---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseFileCard from '../components/CaseFileCard.astro';
import Logo from '../components/Logo.astro';
import SkillRecord from '../components/SkillRecord.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Telemetry from '../components/Telemetry.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import portrait from '../assets/profile/portrait.jpg';
import { PERSON_ID, WEBSITE_ID, absoluteUrl } from '../lib/seo';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.start.getTime() - a.data.start.getTime()
);
const internships = works.filter((w) => w.data.kind === 'internship');
const projects = works.filter((w) => w.data.kind !== 'internship');

const education = (await getCollection('education')).sort((a, b) => a.data.order - b.data.order);
const positions = (await getCollection('positions')).sort((a, b) => a.data.order - b.data.order);
const skillGroups = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const awards = (await getCollection('awards')).sort((a, b) => a.data.order - b.data.order);

const profilePage = {
  '@type': 'ProfilePage',
  '@id': `${site.url}/#profile`,
  url: `${site.url}/`,
  name: site.title,
  description: site.description,
  isPartOf: { '@id': WEBSITE_ID },
  mainEntity: { '@id': PERSON_ID },
  about: { '@id': PERSON_ID },
  hasPart: works.map((w) => ({
    '@type': 'CreativeWork',
    name: w.data.title,
    url: absoluteUrl(`/projects/${w.id}`),
  })),
};
---

<BaseLayout type="profile" jsonLd={[profilePage]}>
  <section class="hero band band--lead" data-section="00" data-section-label="PROFILE">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="label">§ 00 // PROFILE</p>
        <Logo size="hero" text="Joshua John" as="h1" />
        <p class="headline" data-scramble={site.tagline}>{site.tagline}</p>
        <p class="sub mono">CONTROL · ROBOTICS · SIMULATION // NIT TRICHY / IIT MADRAS / EPFL</p>
        <p class="clearance mono">
          FOR BROTHERHOOD? WHY DON'T YOU TRY USING THE <span
            class="terminal-cue mono"
            role="button"
            tabindex="0"
            aria-label="Unauthorised terminal, by pressing ` or clicking here. Opens the terminal."
            data-terminal-open
          >UNAUTHORISED TERMINAL, BY PRESSING ` OR CLICKING HERE.</span> THOUGHTCRIME IS DEATH.
        </p>
        <Telemetry />
      </div>
      <div class="hero-aside">
        <div class="hero-portrait">
          <Image src={portrait} alt={`Portrait of ${site.person.name} (${site.name}), robotics and control-systems engineer`} widths={[320, 480, 640, 900, 1200]} sizes="(min-width: 900px) 30rem, 60vw" />
        </div>
        <SocialLinks />
      </div>
    </div>

    <a class="scroll-cue mono" href="#education">
      <span class="scroll-cue-rule" aria-hidden="true"></span>
      <span>SCROLL. BIG BROTHER IS WATCHING.</span>
    </a>
  </section>

  <section class="band" id="education" data-section="01" data-section-label="EDUCATION">
    <div class="container section-grid">
      <div class="rail">
        <p class="rail-no mono">§ 01</p>
        <h2 class="rail-label">Education</h2>
      </div>
      <div class="body">
        <div class="dossier-grid">
          {
            education.map((e) => (
              <article class="dossier-entry">
                <p class="org">{e.data.institution}</p>
                <p class="degree">{e.data.degree}</p>
                <p class="meta mono">{e.data.location} · {e.data.start} to {e.data.end} · {e.data.detail}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="band band--sunken" data-section="02" data-section-label="POSITIONS">
    <div class="container section-grid">
      <div class="rail">
        <p class="rail-no mono">§ 02</p>
        <h2 class="rail-label">Positions</h2>
      </div>
      <div class="body">
        <ul class="list-entries">
          {
            positions.map((p) => (
              <li>
                <p class="org">{p.data.role} at {p.data.org}</p>
                <p class="meta mono">{p.data.start} to {p.data.end}</p>
                <p class="meta">{p.data.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="band" data-section="03" data-section-label="INTERNSHIPS">
    <div class="container section-grid">
      <div class="rail">
        <p class="rail-no mono">§ 03</p>
        <h2 class="rail-label">Internships</h2>
        <a class="view-all mono" href="/projects">ALL CASE FILES →</a>
      </div>
      <div class="body">
        <div class="case-grid">
          {
            internships.map((work, i) => (
              <CaseFileCard
                variant={i === 0 ? 'grid' : 'feature'}
                slug={work.id}
                fileNo={work.data.fileNo}
                codename={work.data.codename}
                title={work.data.title}
                org={work.data.org}
                start={work.data.start}
                end={work.data.end}
                status={work.data.status}
                kind={work.data.kind}
                summary={work.data.summary}
                tags={work.data.tags}
                cover={work.data.cover}
                coverAlt={work.data.coverAlt}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="band band--sunken" data-section="04" data-section-label="PROJECTS">
    <div class="container section-grid">
      <div class="rail">
        <p class="rail-no mono">§ 04</p>
        <h2 class="rail-label">Projects</h2>
        <a class="view-all mono" href="/projects">ALL CASE FILES →</a>
      </div>
      <div class="body">
        <div class="case-grid">
          {
            projects.map((work, i) => (
              <CaseFileCard
                variant={i === 0 ? 'grid' : 'feature'}
                slug={work.id}
                fileNo={work.data.fileNo}
                codename={work.data.codename}
                title={work.data.title}
                org={work.data.org}
                start={work.data.start}
                end={work.data.end}
                status={work.data.status}
                kind={work.data.kind}
                summary={work.data.summary}
                tags={work.data.tags}
                cover={work.data.cover}
                coverAlt={work.data.coverAlt}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="band" data-section="05" data-section-label="SKILLS">
    <div class="container section-grid">
      <div class="rail">
        <p class="rail-no mono">§ 05</p>
        <h2 class="rail-label">Skills</h2>
      </div>
      <div class="body">
        <SkillRecord groups={skillGroups} />
      </div>
    </div>
  </section>

  <section class="band band--sunken" data-section="06" data-section-label="AWARDS">
    <div class="container section-grid">
      <div class="rail">
        <p class="rail-no mono">§ 06</p>
        <h2 class="rail-label">Awards</h2>
      </div>
      <div class="body">
        <ul class="list-entries">
          {
            awards.map((a) => (
              <li>
                <p class="org">{a.data.title}</p>
                <p class="meta">{a.data.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */

  .hero-inner {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-6);
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    flex: 1;
    min-width: 0;
  }

  .hero-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-self: center;
    width: min(60vw, 320px);
    /* Lets the TV row size itself off the aside's own rendered width (cqw)
       rather than the full viewport, so it tracks correctly at every one of
       this element's own breakpoints below. */
    container-type: inline-size;
  }

  .hero-portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--line);
    filter: saturate(0.85) sepia(0.08);
    transition: filter var(--dur-slow) var(--ease-out);
  }

  .hero-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (hover: hover) {
    .hero-portrait:hover {
      filter: none;
    }
  }

  @media (min-width: 780px) {
    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--space-8);
    }

    /* Source order is text then portrait; the column-reverse stack below 780px
       puts the photo on top, so name the tracks explicitly here. */
    .hero-text {
      grid-column: 1;
    }

    .hero-aside {
      grid-column: 2;
      align-self: center;
      width: clamp(18rem, 26vw, 30rem);
    }
  }

  /* The hero is the whole first screen. The inner row is capped and centred: past
     --hero-max the pair would otherwise keep drifting apart under a fluid layout
     and all the surplus width would collect as a hole in the middle. */
  @media (min-width: 900px) {
    .hero {
      position: relative;
      display: flex;
      align-items: stretch;
      min-height: calc(100svh - var(--header-h));
      padding-bottom: var(--space-9);

      /* The global type scale keys off viewport WIDTH only. On a wide-but-short
         laptop (1366x768) that makes the wordmark 235px tall on its own and pushes
         the hero past the one screen it is supposed to be. Re-cap the two display
         steps by height as well, scoped to the hero. Logo and the headline read
         these tokens, so nothing else needs to know. */
      --text-3xl: min(clamp(3.2rem, 1.8rem + 6.5vw, 7.5rem), 13vh);
      --text-2xl: min(clamp(2.6rem, 1.8rem + 3.6vw, 4.6rem), 7.4vh);
    }

    .hero-inner {
      width: 100%;
      max-width: var(--hero-max);
      margin-inline: auto;
      align-items: center;
    }

    /* The text column absorbs the slack, so the gap to the photo is the same at
       every width; the headline keeps its own measure inside it. */
    .hero-text {
      justify-content: center;
      min-width: 0;
    }

    /* Fixed 4:5 at every size: it scales, it never squashes. The second term is
       the height budget of one screen converted back into a width (4/5 of it), so
       a short window shrinks the whole frame instead of cropping it flat. The
       extra --space-8 subtracted from the budget makes room for the icon row
       under the photo, which now also lives inside this height budget. */
    .hero-aside {
      width: min(
        clamp(20rem, 26vw, 30rem),
        calc((100svh - var(--header-h) - var(--space-10) - var(--space-8)) * 0.8)
      );
    }
  }

  /* Short laptop screens: trim the hero's own padding and rhythm so it still fits. */
  @media (min-width: 900px) and (max-height: 900px) {
    .hero {
      padding-block: var(--space-6) var(--space-7);
    }

    .hero-text {
      gap: var(--space-4);
    }
  }

  /* Tells people there is more below, and doubles as a real link to it. */
  .scroll-cue {
    display: none;
  }

  @media (min-width: 900px) {
    .scroll-cue {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      bottom: var(--space-6);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-wider);
      color: var(--fg-subtle);
      text-decoration: none;
      transition: color var(--dur) var(--ease-out);
    }

    .scroll-cue:hover,
    .scroll-cue:focus-visible {
      color: var(--signal);
    }

    /* A line that falls, once every few seconds: the smallest thing that reads as
       "down" without an arrow glyph bolted onto the label. */
    .scroll-cue-rule {
      width: 1px;
      height: var(--space-6);
      background: linear-gradient(to bottom, transparent, var(--line-strong));
      overflow: hidden;
      position: relative;
    }

    .scroll-cue-rule::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      top: 0;
      height: 45%;
      background: var(--signal);
      animation: scroll-cue-fall 2.6s var(--ease-in-out) infinite;
    }

    .scroll-cue:hover .scroll-cue-rule {
      background: linear-gradient(to bottom, transparent, var(--signal));
    }
  }

  @keyframes scroll-cue-fall {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    35%,
    65% {
      opacity: 1;
    }
    100% {
      transform: translateY(222%);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue-rule::after {
      animation: none;
      top: auto;
      bottom: 0;
    }
  }

  /* Was the h1; the name took that role, so the tagline carries the heading face itself. */
  .headline {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    font-size: var(--text-2xl);
    max-width: 18ch;
  }

  .sub {
    color: var(--fg-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
  }

  /* The cryptic layer earns its place by being quiet: set at reading size with
     generous leading, it reads as a marginal note rather than a warning label. */
  .clearance {
    max-width: var(--measure-narrow);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    letter-spacing: var(--tracking-wider);
    color: var(--fg-subtle);
  }

  .terminal-cue {
    display: inline;
    color: var(--signal);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--signal-dim);
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .terminal-cue:hover,
  .terminal-cue:focus-visible {
    text-decoration-color: var(--signal);
  }

  /* ---- Margin index ---- */

  .rail-no {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--signal);
  }

  .rail-label {
    font-size: var(--text-lg);
  }

  .view-all {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .view-all:hover {
    color: var(--signal);
  }

  /* ---- Section bodies ---- */

  /* Asymmetric by design: the most recent file leads at full width, the rest
     sit in a two-up beneath it. */
  .case-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
    /* Cards in a row match heights; a file with no cover absorbs the difference
       in its empty slot rather than ending short. */
    align-items: stretch;
  }

  @media (min-width: 900px) {
    .case-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-grid > :global(:first-child) {
      grid-column: 1 / -1;
    }
  }

  .dossier-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 900px) {
    .dossier-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  .dossier-entry {
    padding-left: var(--space-4);
    border-left: 1px solid var(--line);
  }

  .dossier-entry .org {
    font-size: var(--text-md);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--stretch-display);
    font-weight: 800;
    line-height: var(--leading-snug);
  }

  .dossier-entry .degree {
    color: var(--fg-muted);
    margin-top: var(--space-1);
  }

  .dossier-entry .meta {
    color: var(--fg-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-2);
  }

  .list-entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .list-entries li {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .list-entries li:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .list-entries .org {
    font-size: var(--text-md);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--stretch-display);
    font-weight: 800;
    line-height: var(--leading-snug);
  }

  .list-entries .meta {
    color: var(--fg-subtle);
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-2);
  }

</style>
