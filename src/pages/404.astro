---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout title={`Unperson — ${site.name}`} description="This page has been vaporized. It never existed.">
  <section class="container unperson">
    <pre class="eye mono" aria-hidden="true">
     .-"""""-.
   .'         '.
  /   .-"""-.   \
 ;   /       \   ;
 |  |    ·    |  |
 ;   \       /   ;
  \   '-...-'   /
   '.         .'
     '-.....-'
</pre>
    <p class="label">404 // UNPERSON</p>
    <h1>This page has been vaporized.</h1>
    <p class="sub">It never existed.</p>
    <a class="home mono" href="/">← RETURN TO INDEX</a>
  </section>
</BaseLayout>

<style>
  .unperson {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-9);
    min-height: 60vh;
  }

  .eye {
    color: var(--signal);
    font-size: var(--text-xs);
    line-height: 1.3;
    opacity: 0.8;
  }

  h1 {
    font-size: var(--text-xl);
    max-width: 20ch;
  }

  .sub {
    color: var(--fg-muted);
  }

  .home {
    margin-top: var(--space-4);
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
  }

  .home:hover {
    color: var(--signal);
  }
</style>
