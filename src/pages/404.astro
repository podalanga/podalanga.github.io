---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout title={`Memory hole · ${site.name}`} description="This entity has been vaporized." noindex>
  <section class="container memory-hole" data-konami-exit>
    <canvas class="eye" data-eye-inline aria-hidden="true"></canvas>
    <p class="label">404 // MEMORY HOLE</p>
    <h1>This entity has been <span class="vaporized">vaporized</span>.</h1>
    <p class="sub">Maybe the Konami code can take you to the exit.</p>
    <p class="keys mono" aria-label="Up, up, down, down, left, right, left, right, B, A">↑ ↑ ↓ ↓ ← → ← → B A</p>
    <a class="home mono" href="/">← RETURN TO PROFILE</a>
  </section>
</BaseLayout>

<style>
  .memory-hole {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-9);
    min-height: 60vh;
  }

  /* The boot loader's eye at a fixed 9:4, the proportions of its almond plus a small margin. */
  .eye {
    display: block;
    width: min(100%, 26rem);
    aspect-ratio: 9 / 4;
  }

  h1 {
    font-size: var(--text-xl);
    max-width: 20ch;
  }

  .vaporized {
    color: var(--signal);
  }

  .sub {
    color: var(--fg-muted);
  }

  .keys {
    color: var(--fg-subtle);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
  }

  .home {
    margin-top: var(--space-4);
    color: var(--fg-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
  }

  .home:hover {
    color: var(--signal);
  }
</style>
