---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkMeta from '../../components/WorkMeta.astro';
import Gallery from '../../components/Gallery.astro';
import Redacted from '../../components/Redacted.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const works = await getCollection('works');
  const sorted = [...works].sort((a, b) => a.data.fileNo - b.data.fileNo);
  return sorted.map((work, i) => ({
    params: { slug: work.id },
    props: {
      work,
      prev: sorted[i - 1],
      next: sorted[i + 1],
    },
  }));
}

const { work, prev, next } = Astro.props;
const { Content } = await render(work);
const { data } = work;
---

<BaseLayout title={`${data.title} · FILE ${String(data.fileNo).padStart(2, '0')}`} description={data.summary}>
  <article class="container case-file">
    <WorkMeta
      fileNo={data.fileNo}
      codename={data.codename}
      org={data.org}
      location={data.location}
      supervisor={data.supervisor}
      start={data.start}
      end={data.end}
      status={data.status}
      stack={data.stack}
    />

    <h1 class="title" transition:name={`title-${work.id}`}>{data.title}</h1>

    {
      data.classified && data.classified.length > 0 && (
        <p class="classified mono">
          CLASSIFIED:{' '}
          {data.classified.map((phrase, i) => (
            <>
              <Redacted text={phrase} />
              {i < data.classified!.length - 1 && ', '}
            </>
          ))}
        </p>
      )
    }

    {
      data.metrics && data.metrics.length > 0 && (
        <dl class="metrics">
          {data.metrics.map((m) => (
            <div>
              <dd>{m.value}</dd>
              <dt class="mono">{m.label}</dt>
            </div>
          ))}
        </dl>
      )
    }

    <div class="case-body">
      <div class="prose">
        <Content />
      </div>

      {
        (data.cover || (data.figures && data.figures.length > 0)) && (
          <aside class="media">
            {
              data.cover && (
                <figure class="cover-figure">
                  <Image src={data.cover} alt={data.coverAlt ?? data.title} widths={[400, 800, 1200]} sizes="(min-width: 780px) 50vw, 100vw" />
                </figure>
              )
            }
            {
              data.figures && data.figures.length > 0 && (
                <Gallery
                  id={`work-${work.id}`}
                  variant="stack"
                  figures={data.figures.map((f) => ({ src: f.src, alt: f.caption, caption: f.caption }))}
                />
              )
            }
          </aside>
        )
      }
    </div>

    <nav class="prev-next mono" aria-label="Other case files">
      {
        prev ? (
          <a href={`/projects/${prev.id}`}>← FILE {String(prev.data.fileNo).padStart(2, '0')} // {prev.data.codename}</a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/projects/${next.id}`}>FILE {String(next.data.fileNo).padStart(2, '0')} // {next.data.codename} →</a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .case-file {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-9);
  }

  .title {
    font-size: var(--text-xl);
    max-width: 24ch;
  }

  .classified {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-5) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .metrics dd {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--stretch-display);
    font-weight: 800;
    font-size: var(--text-lg);
    color: var(--signal);
  }

  .metrics dt {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    letter-spacing: 0.04em;
  }

  .case-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .media {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .cover-figure {
    margin: 0;
  }

  .cover-figure :global(img) {
    display: block;
    width: 100%;
    border: 1px solid var(--line);
  }

  @media (min-width: 780px) {
    .case-body {
      flex-direction: row;
      align-items: flex-start;
    }

    .prose {
      flex: 1;
      min-width: 0;
    }

    .media {
      width: 50%;
      flex-shrink: 0;
      position: sticky;
      top: calc(var(--header-h, 64px) + var(--space-5));
    }
  }

  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .prev-next a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  .prev-next a:hover {
    color: var(--signal);
  }
</style>
