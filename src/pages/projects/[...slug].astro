---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkMeta from '../../components/WorkMeta.astro';
import Carousel from '../../components/Carousel.astro';
import Redacted from '../../components/Redacted.astro';
import { getImage } from 'astro:assets';
import { site } from '../../config/site';
import { PERSON_ID, absoluteUrl, breadcrumbNode, isoDate, pageTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const works = await getCollection('works');
  const sorted = [...works].sort((a, b) => a.data.fileNo - b.data.fileNo);
  return sorted.map((work, i) => ({
    params: { slug: work.id },
    props: {
      work,
      prev: sorted[i - 1],
      next: sorted[i + 1],
    },
  }));
}

const { work, prev, next } = Astro.props;
const { Content } = await render(work);
const { data } = work;

const slides = [
  ...(data.cover
    ? [{ src: data.cover, alt: data.coverAlt ?? data.title, caption: data.coverAlt ?? data.title }]
    : []),
  ...(data.figures ?? [])
    .filter((f) => f.src.src !== data.cover?.src)
    .map((f) => ({ src: f.src, alt: f.caption, caption: f.caption })),
];

const kindLabel = {
  internship: 'Robotics Internship',
  project: 'Robotics Project',
  competition: 'Robotics Competition',
  hobby: 'Hobby Project',
}[data.kind];
const title = pageTitle(`${data.title} · ${kindLabel}`);
const url = absoluteUrl(`/projects/${work.id}`);

// Social card + schema image: a 1200px JPEG rendition of the cover (or first figure).
const coverSrc = data.cover ?? data.figures?.[0]?.src;
const card = coverSrc ? await getImage({ src: coverSrc, width: 1200, format: 'jpg' }) : undefined;
const cardUrl = card ? absoluteUrl(card.src) : undefined;
const images = await Promise.all(
  slides.map(async (s) => absoluteUrl((await getImage({ src: s.src, width: 1200, format: 'jpg' })).src)),
);

const jsonLd = [
  {
    '@type': 'TechArticle',
    '@id': `${url}#article`,
    url,
    mainEntityOfPage: url,
    headline: data.title,
    alternativeHeadline: `${data.codename}: ${kindLabel.toLowerCase()} by ${site.person.name}`,
    description: data.summary,
    author: { '@id': PERSON_ID },
    creator: { '@id': PERSON_ID },
    publisher: { '@id': PERSON_ID },
    dateCreated: isoDate(data.start),
    datePublished: isoDate(data.start),
    ...(data.end && { dateModified: isoDate(data.end) }),
    ...(images.length > 0 && { image: images }),
    keywords: [...new Set([...data.tags, ...data.stack])].join(', '),
    about: [...data.tags, ...data.stack].map((name) => ({ '@type': 'Thing', name })),
    genre: kindLabel,
    sourceOrganization: { '@type': 'Organization', name: data.org, address: data.location },
    ...(data.supervisor && { contributor: { '@type': 'Person', name: data.supervisor } }),
    inLanguage: 'en',
  },
  breadcrumbNode([
    { name: site.person.name, path: '/' },
    { name: 'Projects', path: '/projects' },
    { name: data.title, path: `/projects/${work.id}` },
  ]),
];
---

<BaseLayout
  title={title}
  description={data.summary}
  type="article"
  image={cardUrl}
  imageAlt={data.coverAlt ?? data.title}
  publishedTime={data.start}
  modifiedTime={data.end}
  keywords={[...data.tags, ...data.stack]}
  jsonLd={jsonLd}
>
  <article class="container case-file">
    <WorkMeta
      fileNo={data.fileNo}
      codename={data.codename}
      org={data.org}
      location={data.location}
      supervisor={data.supervisor}
      start={data.start}
      end={data.end}
      status={data.status}
      stack={data.stack}
    />

    <h1 class="title" transition:name={`title-${work.id}`}>{data.title}</h1>

    {
      data.classified && data.classified.length > 0 && (
        <p class="classified mono">
          CLASSIFIED:{' '}
          {data.classified.map((phrase, i) => (
            <>
              <Redacted text={phrase} />
              {i < data.classified!.length - 1 && ', '}
            </>
          ))}
        </p>
      )
    }

    {
      data.metrics && data.metrics.length > 0 && (
        <dl class="metrics">
          {data.metrics.map((m) => (
            <div>
              <dd>{m.value}</dd>
              <dt class="mono">{m.label}</dt>
            </div>
          ))}
        </dl>
      )
    }

    <div class="case-body">
      <div class="prose">
        <Content />
      </div>

      {
        slides.length > 0 && (
          <aside class="media">
            <Carousel id={`work-${work.id}`} figures={slides} />
          </aside>
        )
      }
    </div>

    <nav class="prev-next mono" aria-label="Other case files">
      {
        prev ? (
          <a href={`/projects/${prev.id}/`}>← FILE {String(prev.data.fileNo).padStart(2, '0')} // {prev.data.codename}</a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/projects/${next.id}/`}>FILE {String(next.data.fileNo).padStart(2, '0')} // {next.data.codename} →</a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .case-file {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-9);
  }

  .title {
    font-size: var(--text-xl);
    max-width: 24ch;
  }

  .classified {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-5) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .metrics dd {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--stretch-display);
    font-weight: 800;
    font-size: var(--text-lg);
    color: var(--signal);
  }

  .metrics dt {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    letter-spacing: 0.04em;
  }

  .case-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .media {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    /* Below 780px .case-body stacks in source order (prose, then media); put
       the carousel first so images lead on narrow screens. */
    order: -1;
  }

  @media (min-width: 780px) {
    .case-body {
      flex-direction: row;
      align-items: flex-start;
    }

    .prose {
      flex: 1;
      min-width: 0;
    }

    .media {
      order: 0;
      width: 50%;
      flex-shrink: 0;
      position: sticky;
      top: calc(var(--header-h, 64px) + var(--space-5));
    }
  }

  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .prev-next a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  .prev-next a:hover {
    color: var(--signal);
  }
</style>
