---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Attachments from '../../components/Attachments.astro';
import Tag from '../../components/Tag.astro';
import { Image } from 'astro:assets';
import { formatDateLong } from '../../lib/dates';
import { getImage } from 'astro:assets';
import { site } from '../../config/site';
import { PERSON_ID, WEBSITE_ID, absoluteUrl, breadcrumbNode, pageTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('log', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  const sorted = [...posts].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: sorted[i - 1], next: sorted[i + 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const { data } = post;

const url = absoluteUrl(`/blog/${post.id}`);
const card = data.cover ? await getImage({ src: data.cover, width: 1200, format: 'jpg' }) : undefined;
const cardUrl = card ? absoluteUrl(card.src) : undefined;
const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    url,
    mainEntityOfPage: url,
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    author: { '@id': PERSON_ID },
    publisher: { '@id': PERSON_ID },
    isPartOf: { '@id': WEBSITE_ID },
    ...(cardUrl && { image: cardUrl }),
    keywords: data.tags.join(', '),
    inLanguage: 'en',
  },
  breadcrumbNode([
    { name: site.person.name, path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: data.title, path: `/blog/${post.id}` },
  ]),
];
---

<BaseLayout
  title={pageTitle(`${data.title} · Blog`)}
  description={data.description}
  type="article"
  image={cardUrl}
  imageAlt={data.coverAlt ?? data.title}
  publishedTime={data.date}
  modifiedTime={data.updated}
  keywords={data.tags}
  jsonLd={jsonLd}
>
  <article class="container post">
    <header class="post-header">
      <p class="date mono">{formatDateLong(data.date)}{data.updated && ` · UPDATED ${formatDateLong(data.updated)}`}</p>
      <h1>{data.title}</h1>
      <p class="description">{data.description}</p>
      {
        data.tags.length > 0 && (
          <ul class="tags">
            {data.tags.map((tag) => (
              <li>
                <Tag label={tag} href={`/blog/tag/${tag}`} />
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {data.cover && <Image src={data.cover} alt={data.coverAlt ?? data.title} class="cover" widths={[640, 1200, 1800]} sizes="100vw" />}

    <div class="prose">
      <Content />
    </div>

    {
      data.attachments && data.attachments.length > 0 && (
        <section class="attachments-section">
          <h2 class="section-title">Attachments</h2>
          <Attachments attachments={data.attachments} />
        </section>
      )
    }

    <nav class="prev-next mono" aria-label="Other log entries">
      {prev ? <a href={`/blog/${prev.id}`}>← {prev.data.title}</a> : <span />}
      {next && <a href={`/blog/${next.id}`}>{next.data.title} →</a>}
    </nav>
  </article>
</BaseLayout>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-9);
    max-width: 72ch;
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .date {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }

  .description {
    color: var(--fg-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post :global(.cover) {
    width: 100%;
    border: 1px solid var(--line);
  }

  .section-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
  }

  .prev-next a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  .prev-next a:hover {
    color: var(--signal);
  }
</style>
