---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Attachments from '../../components/Attachments.astro';
import PostHero from '../../components/blog/PostHero.astro';
import PostIndex from '../../components/blog/PostIndex.astro';
import PostEnd from '../../components/blog/PostEnd.astro';
import FigureZoom from '../../components/blog/FigureZoom.astro';
import { getImage } from 'astro:assets';
import { readingStats, tableOfContents } from '../../lib/reading';
import '../../styles/article.css';
import { site } from '../../config/site';
import { PERSON_ID, WEBSITE_ID, absoluteUrl, breadcrumbNode, pageTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('log', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  const sorted = [...posts].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
  return sorted.map((post, i) => {
    const series = post.data.series;
    const parts = series
      ? sorted
          .filter((p) => p.data.series?.title === series.title)
          .map((p) => ({ id: p.id, title: p.data.title, date: p.data.date, part: p.data.series!.part }))
          .sort((a, b) => a.part - b.part)
      : [];
    return {
      params: { slug: post.id },
      props: { post, prev: sorted[i - 1], next: sorted[i + 1], parts },
    };
  });
}

const { post, prev, next, parts } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;
const stats = readingStats(post.body ?? '');
const toc = tableOfContents(headings);
const authors = data.authors?.length ? data.authors : [site.person.name];
const link = (p?: typeof prev) => p && { id: p.id, title: p.data.title, date: p.data.date };

const url = absoluteUrl(`/blog/${post.id}`);
const card = data.cover ? await getImage({ src: data.cover, width: 1200, format: 'jpg' }) : undefined;
const cardUrl = card ? absoluteUrl(card.src) : undefined;
const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    url,
    mainEntityOfPage: url,
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    author: authors.map((name) => (name === site.person.name ? { '@id': PERSON_ID } : { '@type': 'Person', name })),
    publisher: { '@id': PERSON_ID },
    isPartOf: { '@id': WEBSITE_ID },
    ...(cardUrl && { image: cardUrl }),
    keywords: data.tags.join(', '),
    wordCount: stats.words,
    timeRequired: `PT${stats.minutes}M`,
    inLanguage: 'en',
  },
  breadcrumbNode([
    { name: site.person.name, path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: data.title, path: `/blog/${post.id}` },
  ]),
];
---

<BaseLayout
  title={pageTitle(`${data.title} · Blog`)}
  description={data.description}
  type="article"
  image={cardUrl}
  imageAlt={data.coverAlt ?? data.title}
  publishedTime={data.date}
  modifiedTime={data.updated}
  keywords={data.tags}
  jsonLd={jsonLd}
>
  <article class="container post-layout">
    <div class="post-hero-area">
      <PostHero
        title={data.title}
        description={data.description}
        date={data.date}
        updated={data.updated}
        authors={authors}
        context={data.context}
        series={data.series && { ...data.series, total: parts.length }}
        tags={data.tags}
        stats={stats}
      />
    </div>

    {toc.length > 0 && <PostIndex toc={toc} />}

    <div class="post-body">
      <div class="article-body" data-article-body>
        <Content />
      </div>

      {
        data.attachments && data.attachments.length > 0 && (
          <section class="attachments-section">
            <h2 class="section-title">Attachments</h2>
            <Attachments attachments={data.attachments} />
          </section>
        )
      }

      <PostEnd
        series={data.series && { title: data.series.title, current: post.id, parts }}
        prev={link(prev)}
        next={link(next)}
      />
    </div>
  </article>
  <FigureZoom />
</BaseLayout>

<style>
  /* Narrow: hero, then the index bar (sticky under the header), then the text.
     Wide: the index is a rail down the left, beside both the hero and the text. */
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'hero'
      'index'
      'body';
    max-width: 78rem;
    padding-block: var(--space-7) var(--space-9);
  }

  .post-hero-area {
    grid-area: hero;
  }

  .post-layout > :global(.post-index) {
    grid-area: index;
    align-self: start;
  }

  .post-body {
    grid-area: body;
    min-width: 0;
    padding-top: var(--space-6);
  }

  @media (min-width: 1100px) {
    .post-layout {
      grid-template-columns: 13.5rem minmax(0, 1fr);
      grid-template-areas:
        'index hero'
        'index body';
      column-gap: clamp(3rem, 5vw, 5.5rem);
      padding-top: var(--space-8);
    }

    .post-body {
      padding-top: 0;
    }
  }

  .section-title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .attachments-section {
    margin-top: var(--space-8);
    max-width: 40rem;
  }
</style>
