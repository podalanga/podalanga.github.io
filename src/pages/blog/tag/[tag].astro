---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { site } from '../../../config/site';
import { pageTitle } from '../../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('log', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  const tags = new Set<string>();
  posts.forEach((post) => post.data.tags.forEach((tag) => tags.add(tag)));
  return [...tags].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={pageTitle(`#${tag} · Blog`)} description={`Blog entries by ${site.person.name} tagged ${tag}.`} noindex>
  <section class="container intro">
    <p class="dek"><a href="/blog/">All posts</a></p>
    <h1>Posts tagged {tag}</h1>
  </section>

  <section class="container posts">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-7) var(--space-5);
  }

  .dek a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  .dek a:hover {
    color: var(--signal);
  }

  .intro,
  .posts {
    max-width: 78rem;
  }

  .posts {
    padding-bottom: var(--space-8);
  }
</style>
