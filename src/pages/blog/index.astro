---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { site } from '../../config/site';
import { pageTitle } from '../../lib/seo';

// Newest first; posts from the same day keep their series order.
const posts = (await getCollection('log', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || (a.data.series?.part ?? 0) - (b.data.series?.part ?? 0),
);
---

<BaseLayout title={pageTitle('Blog')} description={`Blog of ${site.person.name} (${site.name}): a working log of robotics builds, control-systems projects and stray thoughts.`}>
  <section class="container intro">
    <h1>Blog</h1>
    <p class="dek">A working log of builds, coursework and seminars. Follow it by <a href="/rss.xml">RSS</a>.</p>
    <!-- Shown by bookmarks.ts; saved posts and progress live only in this browser. -->
    <div class="filter mono" data-post-filter role="group" aria-label="Show posts" hidden>
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      <button type="button" data-filter="saved" aria-pressed="false">Saved</button>
      <button type="button" data-filter="progress" aria-pressed="false">In progress</button>
    </div>
    <p class="filter-empty mono" data-filter-empty hidden></p>
  </section>

  <section class="container posts">
    {posts.map((post, i) => <PostCard post={post} eager={i < 2} />)}
  </section>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 78rem;
    padding-block: var(--space-8) var(--space-4);
  }

  h1 {
    font-size: var(--text-2xl);
    font-variation-settings: 'wdth' var(--stretch-display);
  }

  .dek {
    max-width: var(--measure);
    font-size: var(--text-md);
    color: var(--fg-muted);
  }

  .dek a {
    color: var(--fg-muted);
  }

  .dek a:hover {
    color: var(--signal);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .filter[hidden],
  .filter-empty[hidden] {
    display: none;
  }

  .filter button {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--line-strong);
    background: none;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-normal);
    cursor: pointer;
  }

  .filter button:hover {
    color: var(--fg);
  }

  .filter button[aria-pressed='true'] {
    border-color: var(--signal);
    color: var(--signal);
  }

  .filter-empty {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  /* Every post the same card, in an even grid: two or three across on a desktop, one on a phone. */
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    grid-auto-rows: 1fr;
    gap: var(--space-5);
    max-width: 78rem;
    padding-top: var(--space-5);
    padding-bottom: var(--space-9);
  }
</style>
