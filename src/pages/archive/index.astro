---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { formatDateLong } from '../../lib/dates';
import { site } from '../../config/site';

const entries = await getCollection('archive');
const byCategory = {
  photography: entries.filter((e) => e.data.category === 'photography').sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
  music: entries.filter((e) => e.data.category === 'music').sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
  videos: entries.filter((e) => e.data.category === 'videos').sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
  misc: entries.filter((e) => e.data.category === 'misc').sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
};

const photoFigures = byCategory.photography
  .filter((e) => e.data.kind === 'photo' && e.data.image)
  .map((e) => ({
    src: e.data.image!,
    alt: e.data.alt ?? e.data.title,
    caption: `${e.data.title} · ${formatDateLong(e.data.date)}`,
  }));

const categories: { label: string; value: 'photography' | 'music' | 'videos' | 'misc' }[] = [
  { label: 'PHOTOGRAPHY', value: 'photography' },
  { label: 'MUSIC', value: 'music' },
  { label: 'VIDEOS', value: 'videos' },
  { label: 'MISCELLANEOUS', value: 'misc' },
];
---

<BaseLayout title={`Archive · ${site.name}`} description="A running archive of photography, music, and miscellaneous transmissions.">
  <section class="container intro">
    <p class="label">§ 02 // ARCHIVE</p>
    <h1>Archive</h1>
    <p class="dek">Photographs, audio, and things that don't fit a case file.</p>
  </section>

  <section class="container filters" aria-label="Filter archive by category">
    <div class="chips mono" role="group">
      {
        categories.map((c) => (
          <button type="button" class="chip" data-filter={c.value} aria-pressed={c.value === 'photography'}>
            {c.label}
          </button>
        ))
      }
    </div>
  </section>

  <section class="container archive-groups">
    <div class="archive-group" data-category="photography">
      {
        photoFigures.length > 0 ? (
          <Gallery id="archive-photography" figures={photoFigures} variant="masonry" />
        ) : (
          <p class="empty mono">NO TRANSMISSIONS RECEIVED</p>
        )
      }
    </div>

    <div class="archive-group" data-category="music">
      {
        byCategory.music.length > 0 ? (
          <div class="video-grid">
            {byCategory.music.map((e) => e.data.youtube && <YouTubeEmbed url={e.data.youtube} title={e.data.title} />)}
          </div>
        ) : (
          <p class="empty mono">NO TRANSMISSIONS RECEIVED</p>
        )
      }
    </div>

    <div class="archive-group" data-category="videos">
      {
        byCategory.videos.length > 0 ? (
          <div class="video-grid">
            {byCategory.videos.map((e) => e.data.youtube && <YouTubeEmbed url={e.data.youtube} title={e.data.title} />)}
          </div>
        ) : (
          <p class="empty mono">NO TRANSMISSIONS RECEIVED</p>
        )
      }
    </div>

    <div class="archive-group" data-category="misc">
      {
        byCategory.misc.length > 0 ? (
          <div class="video-grid">
            {byCategory.misc.map((e) => e.data.youtube && <YouTubeEmbed url={e.data.youtube} title={e.data.title} />)}
          </div>
        ) : (
          <p class="empty mono">NO TRANSMISSIONS RECEIVED</p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-7) var(--space-5);
  }

  .dek {
    color: var(--fg-muted);
    max-width: 52ch;
  }

  .filters {
    padding-block: 0 var(--space-5);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    background: none;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .chip:hover {
    color: var(--fg);
    border-color: var(--line-strong);
    background: var(--surface-hover);
  }

  .chip[aria-pressed='true'] {
    border-color: var(--signal);
    color: var(--signal);
  }

  .archive-groups {
    padding-top: 0;
    padding-bottom: var(--space-7);
  }

  .archive-group[hidden] {
    display: none;
  }

  .empty {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }
</style>

<script>
  function initFilters() {
    const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
    const groups = document.querySelectorAll<HTMLElement>('.archive-group');

    function applyFilter(filter: string | undefined) {
      groups.forEach((group) => {
        group.hidden = group.dataset.category !== filter;
      });
    }

    const pressed = document.querySelector<HTMLButtonElement>('.chip[aria-pressed="true"]');
    applyFilter(pressed?.dataset.filter);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        applyFilter(filter);
      });
    });
  }

  initFilters();
  document.addEventListener('astro:page-load', initFilters);
</script>
