---
// The top of a post: type only, no cover image (the cover is the list thumbnail and social card,
// and is usually one of the post's own figures, which then appears once, in context).
import Tag from '../Tag.astro';
import { formatDateLong } from '../../lib/dates';
import type { ReadingStats } from '../../lib/reading';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  authors: string[];
  context?: string;
  series?: { title: string; part: number; total: number };
  tags: string[];
  stats: ReadingStats;
}

const { title, description, date, updated, authors, context, series, tags, stats } = Astro.props;
const words = stats.words.toLocaleString('en-GB');
const byline = authors.length > 1 ? `${authors.slice(0, -1).join(', ')} and ${authors.at(-1)}` : authors[0];
---

<header class="post-hero">
  {
    series && (
      <p class="series mono">
        {series.title}, part {series.part} of {series.total}
      </p>
    )
  }
  <h1 class="title">{title}</h1>
  <p class="dek">{description}</p>

  <dl class="facts">
    <div>
      <dt class="mono">Written by</dt>
      <dd>{byline}</dd>
    </div>
    <div>
      <dt class="mono">Published</dt>
      <dd><time datetime={date.toISOString()}>{formatDateLong(date)}</time></dd>
    </div>
    {
      updated && (
        <div>
          <dt class="mono">Updated</dt>
          <dd><time datetime={updated.toISOString()}>{formatDateLong(updated)}</time></dd>
        </div>
      )
    }
    <div>
      <dt class="mono">Reading time</dt>
      <dd>{stats.minutes} min</dd>
    </div>
    <div>
      <dt class="mono">Length</dt>
      <dd>{words} words{stats.figures > 0 && `, ${stats.figures} figures`}</dd>
    </div>
  </dl>

  {context && <p class="context">{context}</p>}

  <!-- Revealed by bookmarks.ts; a saved post is remembered in this browser only. -->
  <button type="button" class="save mono" data-save-post aria-pressed="false" hidden>
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M4 1.8h8v12.4L8 11.4l-4 2.8z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>
    <span data-save-label>Save post</span>
  </button>

  {
    tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {tags.map((tag) => (
          <li>
            <Tag label={tag} href={`/blog/tag/${tag}/`} />
          </li>
        ))}
      </ul>
    )
  }
</header>

<style>
  .post-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-bottom: var(--space-7);
  }

  .series {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-normal);
    color: var(--signal);
  }

  .title {
    max-width: 18ch;
    font-size: clamp(2.3rem, 1.5rem + 3.2vw, 4.4rem);
    font-variation-settings: 'wdth' var(--stretch-display);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .dek {
    max-width: 52ch;
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: var(--space-4) var(--space-5);
    margin: var(--space-2) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .facts dt {
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .facts dd {
    margin: 0;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .context {
    max-width: 62ch;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .save {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line-strong);
    background: none;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-normal);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .save[hidden] {
    display: none;
  }

  .save svg path {
    fill: none;
  }

  .save:hover {
    color: var(--fg);
    border-color: var(--fg-muted);
  }

  .save[aria-pressed='true'] {
    color: var(--signal);
    border-color: var(--signal);
  }

  .save[aria-pressed='true'] svg path {
    fill: currentColor;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
