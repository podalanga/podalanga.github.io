---
// One dialog for the whole post: any figure frame (`[data-zoom]`, written by blog-article.ts)
// opens its image here at full size, with its caption. Esc, the close button or a click on the
// backdrop closes it and focus returns to the figure.
---

<dialog class="zoom" data-figure-zoom aria-label="Figure">
  <button type="button" class="close mono" data-zoom-close aria-label="Close figure">Close</button>
  <figure>
    <img class="zoom-img" alt="" />
    <figcaption class="zoom-caption"></figcaption>
  </figure>
</dialog>

<script>
  function setup(): () => void {
    const dialog = document.querySelector<HTMLDialogElement>('[data-figure-zoom]');
    if (!dialog) return () => {};
    const img = dialog.querySelector<HTMLImageElement>('.zoom-img')!;
    const caption = dialog.querySelector<HTMLElement>('.zoom-caption')!;

    function open(frame: HTMLElement): void {
      const source = frame.querySelector('img');
      if (!source) return;
      img.src = source.currentSrc || source.src;
      img.alt = source.alt;
      const text = frame.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? '';
      caption.textContent = text;
      caption.hidden = !text;
      dialog!.setAttribute('aria-label', text || source.alt || 'Figure');
      dialog!.showModal();
    }

    function onClick(e: MouseEvent): void {
      const frame = (e.target as Element).closest<HTMLElement>('[data-zoom]');
      if (frame) open(frame);
    }

    function onDialogClick(e: MouseEvent): void {
      // A click on the dialog itself (not the image or caption) is a click on the backdrop.
      if (e.target === dialog || (e.target as Element).closest('[data-zoom-close]')) dialog!.close();
    }

    document.addEventListener('click', onClick);
    dialog.addEventListener('click', onDialogClick);
    return () => {
      document.removeEventListener('click', onClick);
      dialog.removeEventListener('click', onDialogClick);
    };
  }

  let destroy: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    destroy?.();
    destroy = setup();
  });
</script>

<style>
  .zoom {
    display: none;
  }

  .zoom[open] {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: var(--space-8) var(--gutter) var(--space-6);
    border: 0;
    background: color-mix(in srgb, var(--bg) 97%, transparent);
    color: var(--fg);
    animation: zoom-in var(--dur-slow) var(--ease-out);
  }

  .zoom::backdrop {
    background: var(--scrim);
  }

  @keyframes zoom-in {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
  }

  figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    max-width: min(100%, 110rem);
  }

  .zoom-img {
    max-width: 100%;
    max-height: calc(100vh - 12rem);
    object-fit: contain;
    background: #fff;
    padding: var(--space-3);
  }

  .zoom-caption {
    max-width: 70ch;
    font-size: var(--text-sm);
    color: var(--fg-muted);
    text-align: center;
  }

  .close {
    position: fixed;
    top: var(--space-5);
    right: var(--gutter);
    padding: var(--space-2) var(--space-3);
    background: none;
    border: 1px solid var(--line-strong);
    color: var(--fg);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .close:hover {
    border-color: var(--signal);
    color: var(--signal);
  }
</style>
