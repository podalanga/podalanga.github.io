---
// The close of a post: the observer's closing line, the rest of the series and the neighbouring
// posts. `data-article-end` is what reading-observer.ts waits for before writing the closing line.
import { formatDateLong } from '../../lib/dates';

interface Link {
  id: string;
  title: string;
  date: Date;
}

interface Props {
  series?: { title: string; current: string; parts: (Link & { part: number })[] };
  prev?: Link;
  next?: Link;
}

const { series, prev, next } = Astro.props;
const inSeries = new Set(series?.parts.map((p) => p.id));
const neighbours = [
  prev && !inSeries.has(prev.id) && { ...prev, rel: 'Older post' },
  next && !inSeries.has(next.id) && { ...next, rel: 'Newer post' },
].filter((n): n is Link & { rel: string } => !!n);
---

<footer class="post-end" data-article-end>
  <p class="closing" aria-live="polite">
    <span class="rec" aria-hidden="true"></span>
    <span data-read-closing hidden></span>
    <noscript>End of post.</noscript>
  </p>

  {
    series && (
      <nav class="series" aria-label={series.title}>
        <h2 class="end-title">{series.title}</h2>
        <ol>
          {series.parts.map((p) => (
            <li>
              {p.id === series.current ? (
                <span class="part current" aria-current="page">
                  <span class="part-no mono">Part {p.part}</span>
                  <span class="part-title">{p.title}</span>
                  <span class="part-note mono">You are here</span>
                </span>
              ) : (
                <a class="part" href={`/blog/${p.id}/`}>
                  <span class="part-no mono">Part {p.part}</span>
                  <span class="part-title">{p.title}</span>
                  <span class="part-note mono">Read part {p.part}</span>
                </a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  {
    neighbours.length > 0 && (
      <nav class="neighbours" aria-label="More posts">
        {neighbours.map((n) => (
          <a class="neighbour" href={`/blog/${n.id}/`}>
            <span class="part-no mono">{n.rel}, {formatDateLong(n.date)}</span>
            <span class="part-title">{n.title}</span>
          </a>
        ))}
      </nav>
    )
  }

  <a class="back mono" href="/blog/">All posts</a>
</footer>

<style>
  .post-end {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    margin-top: var(--space-9);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .closing {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-height: 1.5em;
    font-size: var(--text-md);
    font-variation-settings: 'wdth' var(--stretch-display);
    font-weight: 700;
    line-height: var(--leading-snug);
  }

  .rec {
    flex: none;
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: var(--signal);
    transform: translateY(-0.1em);
    animation: pulse 2.4s var(--ease-in-out) infinite;
    --pulse-trough: 0.35;
  }

  .end-title {
    margin-bottom: var(--space-4);
    font-size: var(--text-base);
    font-weight: 700;
  }

  .series ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 720px) {
    .series ol {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  .part,
  .neighbour {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  a.part:hover,
  .neighbour:hover {
    border-color: var(--signal);
    background: var(--surface-hover);
  }

  .part.current {
    border-color: var(--line-strong);
    background: var(--bg-raised);
  }

  .part-no {
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .part-title {
    font-size: var(--text-md);
    font-weight: 700;
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .part-note {
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .current .part-note {
    color: var(--signal);
  }

  a.part:hover .part-note {
    color: var(--signal);
  }

  .neighbours {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 720px) {
    .neighbours {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  .back {
    align-self: flex-start;
    font-size: var(--text-xs);
    color: var(--fg-muted);
    text-decoration: none;
    padding-block: var(--space-2);
  }

  .back:hover {
    color: var(--signal);
  }
</style>
