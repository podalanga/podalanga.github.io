---
import { getCollection } from 'astro:content';
import { site } from '../config/site';

// Never put the email verbatim in HTML (per CLAUDE.md); split it like ContactEmail.astro does;
// terminal.ts reassembles it before printing to the log.
const [emailUser, emailDomain] = site.email.split('@');

const works = (await getCollection('works'))
  .sort((a, b) => a.data.fileNo - b.data.fileNo)
  .map((w) => ({
    codename: w.data.codename,
    slug: w.id,
    title: w.data.title,
    summary: w.data.summary,
    startYear: w.data.start.getUTCFullYear(),
    endYear: w.data.end?.getUTCFullYear(),
    status: w.data.status,
  }));
---

<div
  id="terminal-context"
  data-email-user={emailUser}
  data-email-domain={emailDomain}
  data-github={site.socials.github}
  data-linkedin={site.socials.linkedin}
  hidden
></div>
<script is:inline type="application/json" id="terminal-works" set:html={JSON.stringify(works)} />

<div id="terminal" class="terminal" role="dialog" aria-modal="true" aria-label="Terminal" aria-hidden="true">
  <div id="terminal-resize" class="resize" aria-hidden="true" title="Drag to resize (or Alt + ↑ / ↓)"></div>
  <div class="bar mono">
    <span>TERMINAL</span>
    <button id="terminal-close" type="button" aria-label="Close terminal">✕</button>
  </div>
  <div id="terminal-log" class="log mono" role="log" aria-live="polite" tabindex="-1">
    <p>Type 'help' for a list of commands. Esc to close.</p>
  </div>
  <form class="input-row mono">
    <span class="prompt" aria-hidden="true">&gt;</span>
    <input
      id="terminal-input"
      type="text"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label="Terminal command"
    />
  </form>
</div>

<style>
  .terminal {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9990;
    /* A set height rather than a content-sized one, so a long listing scrolls inside the log
       and the top edge can be dragged. `--terminal-h` is set by terminal.ts once resized. */
    height: min(var(--terminal-h, 50vh), 90vh);
    height: min(var(--terminal-h, 50dvh), 90dvh);
    min-height: 10rem;
    display: flex;
    flex-direction: column;
    background: var(--bg-raised);
    border-top: 1px solid var(--line);
    transform: translateY(100%);
    box-shadow: 0 -1px 0 var(--line), 0 -24px 48px -24px var(--scrim);
    transition: transform var(--dur) var(--ease-out);
  }

  .terminal.open {
    transform: translateY(0);
  }

  /* Grab strip straddling the top border; the short rule in the middle is the visible grip. */
  .resize {
    position: absolute;
    top: -6px;
    left: 0;
    right: 0;
    height: 12px;
    cursor: ns-resize;
    touch-action: none;
  }

  .resize::after {
    content: '';
    position: absolute;
    top: 5px;
    left: 50%;
    width: 2.5rem;
    height: 2px;
    transform: translateX(-50%);
    background: var(--fg-subtle);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  /* Closed, the panel sits just below the viewport and the strip would poke back into it. */
  .terminal:not(.open) .resize {
    display: none;
  }

  .resize:hover::after,
  .terminal.resizing .resize::after {
    background: var(--signal);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--signal);
  }

  .bar button {
    background: none;
    border: none;
    color: var(--fg-muted);
    cursor: pointer;
    font-size: var(--text-sm);
    line-height: 1;
    padding: var(--space-1);
  }

  .bar button:hover {
    color: var(--signal);
  }

  .log {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .log :global(p) {
    margin: 0 0 var(--space-1);
    max-width: none;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .log :global(p.log-input) {
    margin-top: var(--space-5);
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }

  .log :global(p.log-input:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .log :global(.log-prompt) {
    color: var(--fg);
    font-weight: 600;
  }

  .log :global(p.log-danger) {
    color: var(--signal);
  }

  .input-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--line);
  }

  .prompt {
    color: var(--signal);
  }

  .input-row input {
    flex: 1;
    background: none;
    border: none;
    color: var(--fg);
    font-family: var(--font-mono);
    /* iOS Safari auto-zooms the page on focusing any input under 16px; --text-sm tops out
       below that, so floor it here rather than letting the whole page jump on tap. */
    font-size: max(16px, var(--text-sm));
    outline: none;
  }
</style>
