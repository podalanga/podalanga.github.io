---
interface Props {
  text: string;
  /** Also opens the terminal when clicked (terminal.ts binds every `[data-terminal-open]`). */
  openTerminal?: boolean;
}

const { text, openTerminal = false } = Astro.props;
/** Optional visible stamp painted over the bar (e.g. "REDACTED MOUSE") instead of leaving it blank. */
const hasLabel = Astro.slots.has('label');
---

<span
  class="redacted"
  class:list={{ 'has-label': hasLabel }}
  tabindex="0"
  role="button"
  aria-label={openTerminal ? `${text} (opens the terminal)` : text}
  data-redact={text}
  data-terminal-open={openTerminal ? '' : undefined}
>
  <span class="redact-text mono" aria-hidden="true">{text}</span>
  {
    hasLabel && (
      <span class="redact-label mono" aria-hidden="true">
        <slot name="label" />
      </span>
    )
  }
</span>

<style>
  /* The bar used to be an absolutely-positioned overlay on an `inline-block`, which cannot break
     across lines: a redaction longer than the remaining space took a whole line to itself and left
     the text before it orphaned. Painting it as the text's own background instead lets a long
     redaction wrap inside the sentence like any other run of words, with `box-decoration-break`
     keeping the bar solid on each line it covers. */
  .redacted {
    display: inline;
    cursor: pointer;
  }

  .redacted.has-label {
    display: inline-block;
    position: relative;
  }

  .redact-text {
    background: var(--redact);
    color: transparent;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .redacted.revealed .redact-text {
    background: none;
    color: inherit;
  }

  .redact-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    white-space: nowrap;
    pointer-events: none;
  }

  .redacted.revealed .redact-label {
    opacity: 0;
  }
</style>
