---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;

function extractId(youtubeUrl: string): string | null {
  try {
    const u = new URL(youtubeUrl);
    if (u.hostname.includes('youtu.be')) return u.pathname.slice(1);
    if (u.searchParams.has('v')) return u.searchParams.get('v');
    const match = u.pathname.match(/\/embed\/([^/?]+)/);
    return match ? match[1] : null;
  } catch {
    return null;
  }
}

const videoId = extractId(url);
const thumbnail = videoId ? `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg` : undefined;
---

{
  videoId && (
    <div class="youtube-facade" data-video-id={videoId} data-title={title}>
      <button type="button" class="play" aria-label={`Play video: ${title}`}>
        <img src={thumbnail} alt="" loading="lazy" />
        <span class="icon" aria-hidden="true">▶</span>
      </button>
    </div>
  )
}

<style>
  .youtube-facade {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .play {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .play img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xl);
    color: var(--signal);
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.6);
  }

  .youtube-facade :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  function initFacades(root: ParentNode) {
    root.querySelectorAll<HTMLElement>('.youtube-facade').forEach((facade) => {
      const button = facade.querySelector('.play');
      button?.addEventListener(
        'click',
        () => {
          const id = facade.dataset.videoId;
          const title = facade.dataset.title ?? 'Video';
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
          iframe.title = title;
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          facade.replaceChildren(iframe);
        },
        { once: true }
      );
    });
  }

  initFacades(document);
  document.addEventListener('astro:page-load', () => initFacades(document));
</script>
