---
import { statSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

interface Attachment {
  label: string;
  file: string;
}

interface Props {
  attachments: Attachment[];
}

const { attachments } = Astro.props;

function formatSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function sizeOf(file: string): string | null {
  try {
    const path = fileURLToPath(new URL(`../../public${file}`, import.meta.url));
    return formatSize(statSync(path).size);
  } catch {
    return null;
  }
}

function extOf(file: string): string {
  const match = file.match(/\.([a-z0-9]+)$/i);
  return match ? match[1].toUpperCase() : 'FILE';
}

const items = attachments.map((a) => ({ ...a, size: sizeOf(a.file), ext: extOf(a.file) }));
---

<ul class="attachments mono">
  {
    items.map((item) => (
      <li>
        <a href={item.file} download>
          <span class="ext">{item.ext}</span>
          <span class="label">{item.label}</span>
          {item.size && <span class="size">{item.size}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .attachments {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .attachments a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--fg);
    font-size: var(--text-sm);
    transition: border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .attachments a:hover {
    border-color: var(--signal);
    background: var(--surface-hover);
  }

  .ext {
    color: var(--signal);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .label {
    flex: 1;
  }

  .size {
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }
</style>
