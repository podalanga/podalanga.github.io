---
import { extOf, sizeOf } from '../lib/files';

interface Attachment {
  label: string;
  file: string;
}

interface Props {
  attachments: Attachment[];
}

const { attachments } = Astro.props;

const items = attachments.map((a) => ({ ...a, size: sizeOf(a.file), ext: extOf(a.file) }));
---

<ul class="attachments mono">
  {
    items.map((item) => (
      <li>
        <a href={item.file} download>
          <span class="ext">{item.ext}</span>
          <span class="label">{item.label}</span>
          {item.size && <span class="size">{item.size}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .attachments {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .attachments a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--fg);
    font-size: var(--text-sm);
    transition: border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .attachments a:hover {
    border-color: var(--signal);
    background: var(--surface-hover);
  }

  .ext {
    color: var(--signal);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .label {
    flex: 1;
  }

  .size {
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }
</style>
