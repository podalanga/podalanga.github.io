---
import { DEFAULT_GUIDE, DOCUMENT_KINDS, DOCUMENT_LABEL, pageCount, type DocumentKind } from '../lib/documents';
import { extOf, pageCountOf, sizeOf } from '../lib/files';

interface Document {
  label: string;
  kind: DocumentKind;
  file: string;
  pages?: number;
  guide?: string;
}

interface Props {
  documents: Document[];
}

const { documents } = Astro.props;

// The quick read leads, so a skimming visitor meets it first.
const sorted = [...documents].sort((a, b) => DOCUMENT_KINDS.indexOf(a.kind) - DOCUMENT_KINDS.indexOf(b.kind));
const items = await Promise.all(
  sorted.map(async (doc) => {
    const size = sizeOf(doc.file);
    // Counted from the file itself; a number typed in the CMS overrides it.
    const pages = doc.pages ?? (await pageCountOf(doc.file));
    const facts = [extOf(doc.file), pages ? pageCount(doc.kind, pages) : null, size].filter(Boolean);
    return {
      ...doc,
      facts,
      guideLine: doc.guide ?? DEFAULT_GUIDE[doc.kind],
      filename: doc.file.split('/').pop(),
    };
  }),
);
---

<section class="documents" aria-labelledby="documents-heading">
  <p id="documents-heading" class="heading mono">DOCUMENTS ON FILE · {String(items.length).padStart(2, '0')}</p>
  <ul class="doc-list" data-count={Math.min(items.length, 4)}>
    {
      items.map((doc) => (
        <li class="doc" data-kind={doc.kind}>
          <p class="kind mono">
            <span class="stamp">{DOCUMENT_LABEL[doc.kind]}</span>
            <span class="facts">{doc.facts.join(' · ')}</span>
          </p>
          <p class="doc-title">{doc.label}</p>
          {doc.guideLine && <p class="guide">{doc.guideLine}</p>}
          <div class="actions mono">
            <a href={doc.file} target="_blank" rel="noopener">
              READ <span aria-hidden="true">↗</span>
              <span class="sr-only">{doc.label} (opens in a new tab)</span>
            </a>
            <a href={doc.file} download={doc.filename}>
              DOWNLOAD <span aria-hidden="true">↓</span>
              <span class="sr-only">{doc.label}</span>
            </a>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .documents {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .heading {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    color: var(--fg-muted);
  }

  /* Columns follow the count, so a row never ends with one card left over. */
  .doc-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .doc-list[data-count='1'] {
    max-width: 36rem;
  }

  @media (min-width: 40rem) {
    .doc-list[data-count='2'],
    .doc-list[data-count='4'] {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .doc-list[data-count='3'] {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .doc {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-left: 3px solid var(--signal);
    background: var(--bg-raised);
  }

  .doc[data-kind='other'] {
    border-left-color: var(--line-strong);
  }

  .kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .stamp {
    color: var(--signal);
    font-weight: 700;
  }

  .facts {
    color: var(--fg-subtle);
  }

  .doc-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--fg);
  }

  .guide {
    margin: calc(-1 * var(--space-1)) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--fg-muted);
  }

  .actions {
    display: flex;
    gap: var(--space-2);
    margin-top: auto;
  }

  .actions a {
    flex: 1;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line-strong);
    color: var(--fg);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .actions a:hover {
    border-color: var(--signal);
    background: var(--surface-hover);
    color: var(--signal);
  }

  .actions a:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
