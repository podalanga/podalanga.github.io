---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from './Lightbox.astro';

interface Figure {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  figures: Figure[];
  id: string;
  variant?: 'grid' | 'masonry' | 'stack';
}

const { figures, id, variant = 'grid' } = Astro.props;
const sizes = variant === 'stack' ? '(min-width: 780px) 50vw, 100vw' : '(min-width: 780px) 33vw, 100vw';
---

<div class:list={['gallery', variant]} data-gallery={id}>
  {
    figures.map((figure, i) => (
      <button type="button" class="frame" data-index={i} aria-label={`Open ${figure.caption ?? figure.alt} in lightbox`}>
        <Image src={figure.src} alt={figure.alt} widths={[400, 800, 1200]} sizes={sizes} />
        {figure.caption && <span class="caption mono">{figure.caption}</span>}
      </button>
    ))
  }
</div>

<Lightbox id={id} figures={figures} />

<style>
  .gallery {
    display: grid;
    gap: var(--space-3);
  }

  .gallery.grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .gallery.masonry {
    position: relative;
    display: block;
  }

  .gallery.stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .gallery.masonry .frame {
    position: absolute;
    top: 0;
    left: 0;
  }

  /* no-JS fallback: stack full-width, in document order */
  .gallery.masonry:not(.js-laid-out) .frame {
    position: static;
    width: 100%;
    margin-bottom: var(--space-3);
  }

  .frame {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    cursor: zoom-in;
    overflow: hidden;
  }

  .frame :global(img) {
    width: 100%;
    height: auto;
    filter: saturate(0.85) sepia(0.08);
    transition: filter var(--dur-slow) var(--ease-out);
  }

  @media (hover: hover) {
    .frame:hover :global(img) {
      filter: none;
    }
  }

  .caption {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    letter-spacing: var(--tracking-wide);
    text-align: left;
    border-top: 1px solid var(--line);
  }

</style>

<script>
  function initGallery(root: Element) {
    const id = (root as HTMLElement).dataset.gallery;
    if (!id) return;

    root.querySelectorAll<HTMLButtonElement>('.frame').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(
          new CustomEvent('lightbox:open', { detail: { id, index: Number(btn.dataset.index) } })
        );
      });
    });
  }

  function columnsFor(width: number): number {
    if (width >= 960) return 3;
    if (width >= 560) return 2;
    return 1;
  }

  function layoutMasonry(root: HTMLElement) {
    const frames = Array.from(root.querySelectorAll<HTMLElement>('.frame'));
    if (frames.length === 0) return;

    const columns = columnsFor(root.clientWidth);
    const gap = 12; // matches --space-3
    const columnWidth = (root.clientWidth - gap * (columns - 1)) / columns;
    const columnHeights = new Array(columns).fill(0);

    root.classList.add('js-laid-out');

    frames.forEach((frame) => {
      frame.style.width = `${columnWidth}px`;
      const shortest = columnHeights.indexOf(Math.min(...columnHeights));
      frame.style.left = `${shortest * (columnWidth + gap)}px`;
      frame.style.top = `${columnHeights[shortest]}px`;
      columnHeights[shortest] += frame.offsetHeight + gap;
    });

    root.style.height = `${Math.max(...columnHeights) - gap}px`;
  }

  function initMasonry(root: Element) {
    const el = root as HTMLElement;
    const run = () => layoutMasonry(el);
    run();

    let resizeTimer: number;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(run, 150);
    });

    el.querySelectorAll('img').forEach((img) => {
      if (!(img as HTMLImageElement).complete) img.addEventListener('load', run, { once: true });
    });
  }

  function init() {
    document.querySelectorAll('[data-gallery]').forEach(initGallery);
    document.querySelectorAll('.gallery.masonry').forEach(initMasonry);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
