---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Figure {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  figures: Figure[];
  id: string;
  variant?: 'grid' | 'masonry';
}

const { figures, id, variant = 'grid' } = Astro.props;

const fullSize = await Promise.all(
  figures.map((figure) => getImage({ src: figure.src, width: 2000 }))
);
---

<div class:list={['gallery', variant]} data-gallery={id}>
  {
    figures.map((figure, i) => (
      <button type="button" class="frame" data-index={i} aria-label={`Open ${figure.caption ?? figure.alt} in lightbox`}>
        <Image src={figure.src} alt={figure.alt} widths={[400, 800, 1200]} sizes="(min-width: 780px) 33vw, 100vw" />
        {figure.caption && <span class="caption mono">{figure.caption}</span>}
      </button>
    ))
  }
</div>

<dialog id={`lightbox-${id}`} class="lightbox" aria-label="Image viewer">
  <button type="button" class="close mono" data-action="close" aria-label="Close">✕</button>
  <button type="button" class="nav prev mono" data-action="prev" aria-label="Previous image">‹</button>
  <img class="lightbox-img" alt="" />
  <button type="button" class="nav next mono" data-action="next" aria-label="Next image">›</button>
  <p class="lightbox-caption mono"></p>
</dialog>

<script type="application/json" data-lightbox-data={id} is:inline set:html={JSON.stringify(
  fullSize.map((img, i) => ({ src: img.src, alt: figures[i].alt, caption: figures[i].caption ?? '' }))
)} />

<style>
  .gallery {
    display: grid;
    gap: var(--space-3);
  }

  .gallery.grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .gallery.masonry {
    position: relative;
    display: block;
  }

  .gallery.masonry .frame {
    position: absolute;
    top: 0;
    left: 0;
  }

  /* no-JS fallback: stack full-width, in document order */
  .gallery.masonry:not(.js-laid-out) .frame {
    position: static;
    width: 100%;
    margin-bottom: var(--space-3);
  }

  .frame {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    cursor: zoom-in;
    overflow: hidden;
  }

  .frame :global(img) {
    width: 100%;
    height: auto;
    filter: saturate(0.85) sepia(0.08);
    transition: filter 0.2s var(--ease-out);
  }

  @media (hover: hover) {
    .frame:hover :global(img) {
      filter: none;
    }
  }

  .caption {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    letter-spacing: 0.04em;
    text-align: left;
    border-top: 1px solid var(--line);
  }

  .lightbox {
    display: none;
  }

  .lightbox[open] {
    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: var(--space-5);
    border: 0;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    display: grid;
    grid-template-rows: 1fr auto;
    justify-content: center;
    align-items: center;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.8);
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 80vh;
    margin-inline: auto;
    object-fit: contain;
  }

  .lightbox-caption {
    text-align: center;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    padding-top: var(--space-3);
  }

  .lightbox .close,
  .lightbox .nav {
    position: fixed;
    background: none;
    border: 1px solid var(--line);
    color: var(--fg);
    width: 2.5rem;
    height: 2.5rem;
    font-size: var(--text-md);
    cursor: pointer;
  }

  .lightbox .close {
    top: var(--space-5);
    right: var(--space-5);
  }

  .lightbox .nav.prev {
    left: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox .nav.next {
    right: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox .close:hover,
  .lightbox .nav:hover {
    border-color: var(--signal);
    color: var(--signal);
  }
</style>

<script>
  interface LightboxItem {
    src: string;
    alt: string;
    caption: string;
  }

  function initGallery(root: Element) {
    const id = (root as HTMLElement).dataset.gallery;
    if (!id) return;
    const dialog = document.getElementById(`lightbox-${id}`) as HTMLDialogElement | null;
    const dataEl = document.querySelector(`script[data-lightbox-data="${id}"]`);
    if (!dialog || !dataEl) return;

    const items: LightboxItem[] = JSON.parse(dataEl.textContent || '[]');
    const img = dialog.querySelector('.lightbox-img') as HTMLImageElement;
    const caption = dialog.querySelector('.lightbox-caption') as HTMLElement;
    let current = 0;

    function show(index: number) {
      current = (index + items.length) % items.length;
      const item = items[current];
      img.src = item.src;
      img.alt = item.alt;
      caption.textContent = item.caption;
    }

    function open(index: number) {
      show(index);
      dialog?.showModal();
    }

    root.querySelectorAll<HTMLButtonElement>('.frame').forEach((btn) => {
      btn.addEventListener('click', () => open(Number(btn.dataset.index)));
    });

    dialog.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).dataset.action;
      if (action === 'close') dialog.close();
      if (action === 'prev') show(current - 1);
      if (action === 'next') show(current + 1);
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    let touchStartX = 0;
    dialog.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].clientX;
    });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (dx > 50) show(current - 1);
      if (dx < -50) show(current + 1);
    });
  }

  function columnsFor(width: number): number {
    if (width >= 960) return 3;
    if (width >= 560) return 2;
    return 1;
  }

  function layoutMasonry(root: HTMLElement) {
    const frames = Array.from(root.querySelectorAll<HTMLElement>('.frame'));
    if (frames.length === 0) return;

    const columns = columnsFor(root.clientWidth);
    const gap = 12; // matches --space-3
    const columnWidth = (root.clientWidth - gap * (columns - 1)) / columns;
    const columnHeights = new Array(columns).fill(0);

    root.classList.add('js-laid-out');

    frames.forEach((frame) => {
      frame.style.width = `${columnWidth}px`;
      const shortest = columnHeights.indexOf(Math.min(...columnHeights));
      frame.style.left = `${shortest * (columnWidth + gap)}px`;
      frame.style.top = `${columnHeights[shortest]}px`;
      columnHeights[shortest] += frame.offsetHeight + gap;
    });

    root.style.height = `${Math.max(...columnHeights) - gap}px`;
  }

  function initMasonry(root: Element) {
    const el = root as HTMLElement;
    const run = () => layoutMasonry(el);
    run();

    let resizeTimer: number;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(run, 150);
    });

    el.querySelectorAll('img').forEach((img) => {
      if (!(img as HTMLImageElement).complete) img.addEventListener('load', run, { once: true });
    });
  }

  function init() {
    document.querySelectorAll('[data-gallery]').forEach(initGallery);
    document.querySelectorAll('.gallery.masonry').forEach(initMasonry);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
