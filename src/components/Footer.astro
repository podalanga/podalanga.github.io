---
import { site } from '../config/site';
import Redacted from './Redacted.astro';
import SecurityCamera from './SecurityCamera.astro';
import { LINKS } from './social-icons';

const startYear = new Date(site.epoch).getFullYear();
const [emailUser, emailDomain] = site.email.split('@');
const obfuscatedEmail = site.email.replace('@', '[at]').replace(/\./g, '[dot]');
---

<footer class="site-footer">
  <SecurityCamera />

  <div class="container grid">
    <span class="terminal-hint mono">
      <Redacted text="THERE IS NO ESCAPE OR EXIT" openTerminal>
        <Fragment slot="label">REDACTED <span class="mouse">MOUSE</span></Fragment>
      </Redacted>
    </span>

    <ul class="icon-links">
      {
        LINKS.map((link) => (
          <li>
            <a
              class="icon-link"
              href={link.key === 'email' ? 'mailto:' : link.href}
              data-user={link.key === 'email' ? emailUser : undefined}
              data-domain={link.key === 'email' ? emailDomain : undefined}
              rel={link.key === 'email' ? undefined : 'me noopener noreferrer'}
              target={link.key === 'email' ? undefined : '_blank'}
            >
              <svg viewBox={link.icon.viewBox} aria-hidden="true" focusable="false">
                <path d={link.icon.d} />
              </svg>
              <span class="sr-only">{link.label}</span>
            </a>
            {link.key === 'email' && (
              <noscript>
                <span class="email-fallback mono">
                  {emailUser} [at] {emailDomain.replace('.', ' [dot] ')}
                </span>
              </noscript>
            )}
          </li>
        ))
      }
    </ul>

    <div class="right-group">
      <span class="footer-email mono">{obfuscatedEmail}</span>
      <p class="copy mono">© {startYear}-∞ PODALANGA</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow-x: clip;
    min-height: 90px;
    border-top: 1px solid var(--line);
  }

  .site-footer .container.grid {
    padding-block: var(--space-6);
    padding-inline-start: max(var(--gutter), calc(130px + var(--space-6)));
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .icon-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1 1 auto;
  }

  .right-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .icon-link {
    display: block;
    line-height: 0;
  }

  .icon-link svg {
    width: 1.75rem;
    height: auto;
    fill: var(--fg);
    transition: fill var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .icon-link:hover svg {
      fill: var(--signal);
    }
  }

  .icon-link:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  .email-fallback {
    display: block;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .terminal-hint {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--fg-muted);
  }

  .terminal-hint :global(.mouse) {
    color: var(--signal);
  }

  .footer-email {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--fg-muted);
    user-select: text;
  }

  .copy {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    letter-spacing: var(--tracking-wide);
  }
</style>

<script>
  function assemble(el: HTMLAnchorElement) {
    const user = el.dataset.user;
    const domain = el.dataset.domain;
    if (!user || !domain) return;
    el.href = `mailto:${user}@${domain}`;
  }

  function init() {
    document.querySelectorAll<HTMLAnchorElement>('.icon-link[data-user]').forEach(assemble);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
