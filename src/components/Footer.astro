---
import { site } from '../config/site';

const startYear = new Date(site.epoch).getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div class="ouroboros mono" aria-hidden="true">∞ ∞ ∞ ∞ ∞ ∞</div>

    <div class="links">
      <a href={site.socials.github} rel="me noopener noreferrer" target="_blank" class="mono">
        GITHUB
      </a>
      <a href={site.socials.linkedin} rel="me noopener noreferrer" target="_blank" class="mono">
        LINKEDIN
      </a>
    </div>

    <p class="copy mono">© {startYear}–∞ PODALANGA</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-6);
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .ouroboros {
    color: var(--signal);
    font-size: var(--text-sm);
    letter-spacing: 0.15em;
    opacity: 0.8;
  }

  .links {
    display: flex;
    gap: var(--space-5);
  }

  .links a {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--signal);
  }

  .copy {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    letter-spacing: 0.04em;
  }
</style>
