---
import { site } from '../config/site';
import Redacted from './Redacted.astro';
import SecurityCamera from './SecurityCamera.astro';
import Telemetry from './Telemetry.astro';

const startYear = new Date(site.epoch).getFullYear();
---

<footer class="site-footer">
  <SecurityCamera />

  <div class="container grid">
    <div class="links">
      <a href={site.socials.github} rel="me noopener noreferrer" target="_blank" class="mono">
        GITHUB
      </a>
      <a href={site.socials.linkedin} rel="me noopener noreferrer" target="_blank" class="mono">
        LINKEDIN
      </a>
      <span class="terminal-hint mono">
        <Redacted text="THERE IS NO ESCAPE OR EXIT" openTerminal />
      </span>
    </div>

    <Telemetry variant="compact" />

    <p class="copy mono">© {startYear}-∞ PODALANGA</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow-x: clip;
    min-height: 90px;
    border-top: 1px solid var(--line);
  }

  .site-footer .container.grid {
    padding-block: var(--space-6);
    padding-inline-start: max(var(--gutter), calc(130px + var(--space-4)));
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  .links a {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--signal);
  }

  .terminal-hint {
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--fg-muted);
  }

  .copy {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    letter-spacing: 0.04em;
  }
</style>
