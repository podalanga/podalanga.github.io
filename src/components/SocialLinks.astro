---
import { site } from '../config/site';
import { LINKS as SHARED_LINKS } from './social-icons';

const [emailUser, emailDomain] = site.email.split('@');

/**
 * The CRT TV from ascii_tv.txt, cropped to its shape (rows 10-45, cols 11-87
 * of the source file — the surrounding padding trimmed) and rendered as real
 * SVG <text>: a genuine ASCII rendering, not a vector silhouette. Each row
 * sits at font-size 1 with no forced textLength, so every "@" keeps the
 * monospace font's own glyph proportions (measured 0.6 : 1 width:height for
 * this face) instead of being stretched to fill a square cell.
 */
const TV_ROWS = [
  ' @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ ',
  '@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@',
  '@@                                                                         @@',
  '@@      @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@      @@',
  '@@   @  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  @   @@',
  '@@   @  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  @  @@@',
  '@@@  @  @@@@@@                                                 @@@@@@  @  @@@',
  '@@@  @  @@@@                                                     @@@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@@                                                     @@@@  @  @@@',
  '@@@  @  @@@@                                                     @@@@  @  @@@',
  '@@@  @  @@@@@@@@@@@@@@@@@@                         @@@@@@@@@@@@@@@@@@  @  @@@',
  '@@@  @  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  @  @@@',
  '@@@  @  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  @  @@@',
  '@@@          @@@@@@@@@                                @@@@@@@@@@          @@@',
  '@@@                                                                       @@@',
  ' @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ ',
  ' @@@@@@@@    @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@    @@@@@@@@ ',
  '      @@@@@@@ @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ @@@@@@@      ',
  '       @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@       ',
  '          @@@@@@                                             @@@@@@          ',
];
const TV_COLS = 77;
const CHAR_ASPECT = 0.6; // this monospace face's measured glyph-advance : font-size ratio
const TV_ROWS_COUNT = TV_ROWS.length;
const VIEW_W = TV_COLS * CHAR_ASPECT; // 46.2 — keeps every "@" glyph unstretched
const VIEW_H = TV_ROWS_COUNT; // 36

// Screen hollow, in the same cropped grid: columns 12-66, rows 7-26 (of 77x36).
const SCREEN = { x: [12, 66].map((c) => c * CHAR_ASPECT), y: [7, 26] };
const SCREEN_CENTER = {
  x: (SCREEN.x[0] + SCREEN.x[1]) / 2,
  y: (SCREEN.y[0] + SCREEN.y[1]) / 2,
};
const ICON_BOX = 14; // square logo box, well inside the 19-unit-tall screen
const ICON_POS = {
  x: SCREEN_CENTER.x - ICON_BOX / 2,
  y: SCREEN_CENTER.y - ICON_BOX / 2,
};

// `ICONS`/`LINKS` (the path/viewBox data and href list) live in ./social-icons
// so the hero's ASCII-TV treatment and the footer's plain glyphs draw from
// the same source instead of duplicating the SVG path data.
const LINKS = SHARED_LINKS;
---

<ul class="social-links">
  {
    LINKS.map((link) => (
      <li>
        <a
          class="social-link"
          href={link.key === 'email' ? 'mailto:' : link.href}
          data-user={link.key === 'email' ? emailUser : undefined}
          data-domain={link.key === 'email' ? emailDomain : undefined}
          rel={link.key === 'email' ? undefined : 'me noopener noreferrer'}
          target={link.key === 'email' ? undefined : '_blank'}
        >
          <svg class="tv" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} aria-hidden="true" focusable="false">
            {TV_ROWS.map((row, i) => (
              <text x="0" y={i} font-size="1" dominant-baseline="hanging" xml:space="preserve">
                {row}
              </text>
            ))}
            <svg x={ICON_POS.x} y={ICON_POS.y} width={ICON_BOX} height={ICON_BOX} viewBox={link.icon.viewBox} class="logo">
              <path d={link.icon.d} />
            </svg>
          </svg>
          <span class="sr-only">{link.label}</span>
        </a>
        {link.key === 'email' && (
          <noscript>
            <span class="email-fallback mono">
              {emailUser} [at] {emailDomain.replace('.', ' [dot] ')}
            </span>
          </noscript>
        )}
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(0.5rem, 3cqw, 1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .social-link {
    display: block;
    line-height: 0;
    transition: filter var(--dur-fast) var(--ease-out);
  }

  /* Genuine ascii_tv.txt text, red on the page. Sized off the hero-aside's
     own width (cqw, set on that container in index.astro) rather than the
     full viewport, so three sets plus gaps never outrun it at any
     breakpoint, while getting as large as that column allows. */
  .tv {
    width: clamp(3rem, 30cqw, 7.5rem);
    height: auto;
    display: block;
    fill: var(--signal);
    font-family: var(--font-mono);
    user-select: none;
  }

  .social-link:hover .tv,
  .social-link:focus-visible .tv {
    filter: brightness(1.3);
  }

  .logo {
    fill: var(--fg);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .social-link {
      transition: transform var(--dur-fast) var(--ease-out);
    }

    .social-link:hover {
      transform: translateY(-2px);
    }
  }

  .social-link:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  .email-fallback {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    text-align: center;
  }
</style>

<script>
  function assemble(el: HTMLAnchorElement) {
    const user = el.dataset.user;
    const domain = el.dataset.domain;
    if (!user || !domain) return;
    el.href = `mailto:${user}@${domain}`;
  }

  function init() {
    document.querySelectorAll<HTMLAnchorElement>('.social-link[data-user]').forEach(assemble);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
