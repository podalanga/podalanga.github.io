---
import { site } from '../config/site';

const [emailUser, emailDomain] = site.email.split('@');

/**
 * The CRT TV from ascii_tv.txt, cropped to its shape (rows 10-45, cols 11-87
 * of the source file — the surrounding padding trimmed) and rendered as real
 * SVG <text>: a genuine ASCII rendering, not a vector silhouette. Each row
 * sits at font-size 1 with no forced textLength, so every "@" keeps the
 * monospace font's own glyph proportions (measured 0.6 : 1 width:height for
 * this face) instead of being stretched to fill a square cell.
 */
const TV_ROWS = [
  ' @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ ',
  '@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@',
  '@@                                                                         @@',
  '@@      @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@      @@',
  '@@   @  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  @   @@',
  '@@   @  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  @  @@@',
  '@@@  @  @@@@@@                                                 @@@@@@  @  @@@',
  '@@@  @  @@@@                                                     @@@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@                                                       @@@  @  @@@',
  '@@@  @  @@@@                                                     @@@@  @  @@@',
  '@@@  @  @@@@                                                     @@@@  @  @@@',
  '@@@  @  @@@@@@@@@@@@@@@@@@                         @@@@@@@@@@@@@@@@@@  @  @@@',
  '@@@  @  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  @  @@@',
  '@@@  @  @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@  @  @@@',
  '@@@          @@@@@@@@@                                @@@@@@@@@@          @@@',
  '@@@                                                                       @@@',
  ' @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ ',
  ' @@@@@@@@    @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@    @@@@@@@@ ',
  '      @@@@@@@ @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@ @@@@@@@      ',
  '       @@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@       ',
  '          @@@@@@                                             @@@@@@          ',
];
const TV_COLS = 77;
const CHAR_ASPECT = 0.6; // this monospace face's measured glyph-advance : font-size ratio
const TV_ROWS_COUNT = TV_ROWS.length;
const VIEW_W = TV_COLS * CHAR_ASPECT; // 46.2 — keeps every "@" glyph unstretched
const VIEW_H = TV_ROWS_COUNT; // 36

// Screen hollow, in the same cropped grid: columns 12-66, rows 7-26 (of 77x36).
const SCREEN = { x: [12, 66].map((c) => c * CHAR_ASPECT), y: [7, 26] };
const SCREEN_CENTER = {
  x: (SCREEN.x[0] + SCREEN.x[1]) / 2,
  y: (SCREEN.y[0] + SCREEN.y[1]) / 2,
};
const ICON_BOX = 14; // square logo box, well inside the 19-unit-tall screen
const ICON_POS = {
  x: SCREEN_CENTER.x - ICON_BOX / 2,
  y: SCREEN_CENTER.y - ICON_BOX / 2,
};

/**
 * Icon glyphs, 24x24 nominal viewBox, dropped white into the ascii screen's
 * hollow. `viewBox` below is each glyph's own true getBBox() (measured, +10%
 * padding) rather than the nominal 0..24 box — several of these marks (the
 * LinkedIn glyph especially) don't actually fill that full square, so
 * centering on the nominal box reads visibly off-centre; centering on the
 * real ink does not.
 */
const ICONS = {
  email: {
    d: 'M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5zM4 6.6v.8l8 5.6 8-5.6v-.8l-8 5.6zM4 9.5V18h16V9.5l-8 5.6z',
    viewBox: '1 1 22 22',
  },
  github: {
    d: 'M12 2C6.48 2 2 6.58 2 12.19c0 4.49 2.87 8.3 6.84 9.64.5.1.68-.22.68-.49 0-.24-.01-1.03-.01-1.87-2.78.61-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.54 2.34 1.1 2.91.84.09-.66.35-1.1.63-1.35-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.95.68 1.92 0 1.39-.01 2.51-.01 2.85 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.19C22 6.58 17.52 2 12 2z',
    viewBox: '1 0.98 22 22',
  },
  linkedin: {
    d: 'M4.98 3.5C4.98 4.88 3.9 6 2.5 6S0 4.88 0 3.5 1.1 1 2.5 1s2.48 1.12 2.48 2.5zM.24 8.25h4.5V23H.24zM8.14 8.25h4.31v2.01h.06c.6-1.13 2.06-2.33 4.24-2.33 4.53 0 5.37 2.98 5.37 6.86V23h-4.5v-6.36c0-1.52-.03-3.47-2.11-3.47-2.12 0-2.44 1.65-2.44 3.36V23h-4.5z',
    viewBox: '-1.11 -0.17 24.33 24.33',
  },
};

const LINKS = [
  { key: 'email', label: 'Email', href: '#contact', icon: ICONS.email },
  { key: 'github', label: 'GitHub', href: site.socials.github, icon: ICONS.github },
  { key: 'linkedin', label: 'LinkedIn', href: site.socials.linkedin, icon: ICONS.linkedin },
];
---

<ul class="social-links">
  {
    LINKS.map((link) => (
      <li>
        <a
          class="social-link"
          href={link.href}
          data-user={link.key === 'email' ? emailUser : undefined}
          data-domain={link.key === 'email' ? emailDomain : undefined}
          rel={link.key === 'email' ? undefined : 'me noopener noreferrer'}
          target={link.key === 'email' ? undefined : '_blank'}
        >
          <svg class="tv" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} aria-hidden="true" focusable="false">
            {TV_ROWS.map((row, i) => (
              <text x="0" y={i} font-size="1" dominant-baseline="hanging" xml:space="preserve">
                {row}
              </text>
            ))}
            <svg x={ICON_POS.x} y={ICON_POS.y} width={ICON_BOX} height={ICON_BOX} viewBox={link.icon.viewBox} fill="#fff">
              <path d={link.icon.d} />
            </svg>
          </svg>
          <span class="sr-only">{link.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(0.5rem, 3cqw, 1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .social-link {
    display: block;
    line-height: 0;
    transition: filter var(--dur-fast) var(--ease-out);
  }

  /* Genuine ascii_tv.txt text, red on the page. Sized off the hero-aside's
     own width (cqw, set on that container in index.astro) rather than the
     full viewport, so three sets plus gaps never outrun it at any
     breakpoint, while getting as large as that column allows. */
  .tv {
    width: clamp(3rem, 30cqw, 7.5rem);
    height: auto;
    display: block;
    fill: var(--signal);
    font-family: var(--font-mono);
    user-select: none;
  }

  .social-link:hover .tv,
  .social-link:focus-visible .tv {
    filter: brightness(1.3);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .social-link {
      transition: transform var(--dur-fast) var(--ease-out);
    }

    .social-link:hover {
      transform: translateY(-2px);
    }
  }

  .social-link:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }
</style>

<script>
  function assemble(el: HTMLAnchorElement) {
    const user = el.dataset.user;
    const domain = el.dataset.domain;
    if (!user || !domain) return;
    el.href = `mailto:${user}@${domain}`;
  }

  function init() {
    document.querySelectorAll<HTMLAnchorElement>('.social-link[data-user]').forEach(assemble);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
