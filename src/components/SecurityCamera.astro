---
// Small two-layer ASCII CCTV camera bolted into the footer's bottom-left corner, wall bracket
// clipped by the page edge. Two `<pre>` layers share one character grid (see security-camera-art.ts):
// `.mount` (joint + arm + wall plate) never moves; `.head` (the housing) rotates in the page plane
// around the joint via `transform-origin` + `rotate()`, driven by `--angle` from security-camera.ts.
// A glowing red `.lens` dot rides along with the head. Static, unrotated, non-glowing under
// prefers-reduced-motion or no-JS — the ASCII art itself needs no JS at all.
import { HEAD_ART, MOUNT_ART, HEAD_ROWS, PIVOT, LENS } from '../effects/security-camera-art';

const MOUNT_ROWS = MOUNT_ART.split('\n').length;
const TOTAL_ROWS = HEAD_ROWS + MOUNT_ROWS;
const WIDTH_CH = Math.max(
  ...HEAD_ART.split('\n').map((l) => l.length),
  ...MOUNT_ART.split('\n').map((l) => l.length),
);
---

<div
  class="camera-mount"
  data-security-camera
  aria-hidden="true"
  style={`width:${WIDTH_CH}ch; height:${TOTAL_ROWS}em;`}
>
  <pre class="mount" style={`top:${HEAD_ROWS}em;`}>{MOUNT_ART}</pre>
  <div class="head" style={`transform-origin: ${PIVOT.col}ch ${PIVOT.row}em;`}>
    <pre class="art">{HEAD_ART}</pre>
    <span
      class="lens"
      data-camera-lens
      style={`top:${LENS.row + 0.5}em; left:${LENS.col + 0.5}ch;`}
    ></span>
  </div>
  <span class="pivot" data-camera-pivot style={`top:${PIVOT.row}em; left:${PIVOT.col}ch;`}></span>
</div>

<style>
  .camera-mount {
    position: absolute;
    left: -2ch;
    bottom: 0;
    z-index: 0;
    font-family: var(--font-mono);
    font-size: 3.6px;
    line-height: 1em;
    color: var(--fg-muted);
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .camera-mount {
      font-size: 2.6px;
    }
  }

  .mount,
  .art {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    white-space: pre;
    color: inherit;
  }

  .head {
    position: absolute;
    top: 0;
    left: 0;
    transform: rotate(calc(var(--angle, 0) * 1deg));
    transition: transform 0.5s var(--ease-out);
  }

  .lens {
    position: absolute;
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 4px 1px var(--signal);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .pivot {
    position: absolute;
    width: 0;
    height: 0;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .head {
      transition: none;
    }
    .lens {
      animation: none;
    }
  }
</style>
