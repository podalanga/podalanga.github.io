---
// Small two-layer ASCII CCTV camera bolted into the footer's bottom-left corner, wall bracket
// clipped by the page edge. Two `<pre>` layers share one character grid (see security-camera-art.ts):
// `.mount` (joint + arm + wall plate) never moves; `.head` (the housing) rotates in the page plane
// around the joint via `transform-origin` + `rotate()`, driven by `--angle` from security-camera.ts.
// A glowing red `.lens` dot rides along with the head. Static, unrotated, non-glowing under
// prefers-reduced-motion or no-JS — the ASCII art itself needs no JS at all.
//
// The art is laid out at RENDER_FONT_PX (a normal, readable size) and then shrunk to its real
// on-screen size with `transform: scale(var(--camera-scale))` on `.camera-scale`, rather than
// just declaring a tiny `font-size` directly. Browsers that enforce a "minimum font size"
// (an accessibility setting some people have on, e.g. Chrome's chrome://settings/fonts) silently
// floor any font-size below that threshold back up to it — which, for a `font-size: 3.6px` rule,
// blew the whole camera up to several times its intended size while leaving normal ~16px body
// text untouched. `transform: scale()` operates on the already-laid-out box, not on font metrics,
// so it isn't subject to that floor. Every other measurement here (container box, transform
// origin, lens/pivot markers) is plain px arithmetic from RENDER_FONT_PX, not `ch`/`em`, so none
// of it depends on which font is active or how the browser sizes text either.
import { HEAD_ART, MOUNT_ART, HEAD_ROWS, PIVOT, LENS } from '../effects/security-camera-art';

const RENDER_FONT_PX = 16;
const CHAR_W_EM = 0.6; // JetBrains Mono's measured advance width, in ems

const MOUNT_ROWS = MOUNT_ART.split('\n').length;
const TOTAL_ROWS = HEAD_ROWS + MOUNT_ROWS;
const WIDTH_CH = Math.max(
  ...HEAD_ART.split('\n').map((l) => l.length),
  ...MOUNT_ART.split('\n').map((l) => l.length),
);

const renderWidthPx = WIDTH_CH * CHAR_W_EM * RENDER_FONT_PX;
const renderHeightPx = TOTAL_ROWS * RENDER_FONT_PX;
const renderLeftPx = -2 * CHAR_W_EM * RENDER_FONT_PX;
const toEm = (cols: number) => `${(cols * CHAR_W_EM).toFixed(3)}em`;
---

<div
  class="camera-mount"
  data-security-camera
  aria-hidden="true"
  style={`width:calc(${renderWidthPx}px * var(--camera-scale)); height:calc(${renderHeightPx}px * var(--camera-scale)); left:calc(${renderLeftPx}px * var(--camera-scale));`}
>
  <div class="camera-scale" style={`width:${renderWidthPx}px; height:${renderHeightPx}px;`}>
    <pre class="mount" style={`top:${HEAD_ROWS}em;`}>{MOUNT_ART}</pre>
    <div class="head" style={`transform-origin: ${toEm(PIVOT.col)} ${PIVOT.row}em;`}>
      <pre class="art">{HEAD_ART}</pre>
      <span
        class="lens"
        data-camera-lens
        style={`top:${LENS.row + 0.5}em; left:${toEm(LENS.col + 0.5)};`}
      ></span>
    </div>
    <span class="pivot" data-camera-pivot style={`top:${PIVOT.row}em; left:${toEm(PIVOT.col)};`}></span>
  </div>
</div>

<style>
  .camera-mount {
    --camera-scale: 0.225; /* 3.6px visual / RENDER_FONT_PX */
    position: absolute;
    bottom: 0;
    z-index: 0;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .camera-mount {
      --camera-scale: 0.1625; /* 2.6px visual / RENDER_FONT_PX */
    }
  }

  .camera-scale {
    position: absolute;
    top: 0;
    left: 0;
    transform: scale(var(--camera-scale));
    transform-origin: top left;
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1em;
    color: var(--fg-muted);
  }

  .mount,
  .art {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    white-space: pre;
    color: inherit;
  }

  .head {
    position: absolute;
    top: 0;
    left: 0;
    transform: rotate(calc(var(--angle, 0) * 1deg));
    transition: transform 0.5s var(--ease-out);
  }

  .lens {
    /* Sized pre-scale so it comes out to a constant 4px regardless of --camera-scale. */
    position: absolute;
    width: calc(4px / var(--camera-scale));
    height: calc(4px / var(--camera-scale));
    margin: calc(-2px / var(--camera-scale)) 0 0 calc(-2px / var(--camera-scale));
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 calc(4px / var(--camera-scale)) calc(1px / var(--camera-scale)) var(--signal);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .pivot {
    position: absolute;
    width: 0;
    height: 0;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .head {
      transition: none;
    }
    .lens {
      animation: none;
    }
  }
</style>
