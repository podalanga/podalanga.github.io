---
import { site } from '../config/site';

interface Props {
  size?: 'header' | 'hero';
  text?: string;
}
const { size = 'header', text = site.name } = Astro.props;
---

<span class:list={['logo', size]}>
  <a href="/" class="wordmark" aria-label={`${site.name} home`}>{text}</a><button
    type="button"
    class="dot"
    data-terminal-open
    aria-label="Open terminal"
  >.</button>
</span>

<style>
  .logo {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    line-height: 1;
  }

  .wordmark {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--stretch-display);
    font-weight: 900;
    color: var(--fg);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .dot {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    color: var(--signal);
    font-family: var(--font-display);
    font-weight: 900;
    animation: pulse 2.4s ease-in-out infinite;
  }

  .header .wordmark {
    font-size: var(--text-md);
  }

  .hero .wordmark {
    font-size: var(--text-3xl);
  }

  .hero .dot {
    font-size: var(--text-3xl);
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
</style>
