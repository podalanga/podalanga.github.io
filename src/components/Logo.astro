---
import { site } from '../config/site';

interface Props {
  size?: 'header' | 'hero';
  text?: string;
}
const { size = 'header', text = site.name } = Astro.props;

// The dot must always render immediately after the last word: split it off into its own
// non-wrapping unit so it can never land on its own line, detached from the name, when the
// wordmark wraps at narrow widths.
const words = text.trim().split(/\s+/);
const lastWord = words.pop() ?? text;
const leading = words.length ? `${words.join(' ')} ` : '';
---

{/* The hero wordmark is decoration on the page it names, not a link back to itself — only the
   header wordmark navigates home. */}
<span class:list={['logo', size]}>
  {leading && (
    size === 'hero' ? (
      <span class="wordmark lead" aria-hidden="true">{leading}</span>
    ) : (
      <a href="/" class="wordmark lead" aria-hidden="true" tabindex="-1">{leading}</a>
    )
  )}<span class="tail">{size === 'hero' ? (
    <span class="wordmark">{lastWord}</span>
  ) : (
    <a href="/" class="wordmark" aria-label={`${site.name} home`}>{lastWord}</a>
  )}<button
    type="button"
    class="dot"
    data-terminal-open
    aria-label="Open terminal"
  >.</button></span>
</span>

<style>
  .logo {
    position: relative;
    display: inline;
    line-height: 1;
  }

  .tail {
    white-space: nowrap;
  }

  .wordmark {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--stretch-display);
    font-weight: 900;
    color: var(--fg);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .dot {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    color: var(--signal);
    font-family: var(--font-display);
    font-weight: 900;
    animation: pulse 2.4s ease-in-out infinite;
  }

  .header .wordmark {
    font-size: var(--text-md);
  }

  .hero .wordmark {
    font-size: var(--text-3xl);
  }

  .hero .dot {
    font-size: var(--text-3xl);
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
</style>
