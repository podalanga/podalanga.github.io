---
import { site } from '../config/site';

interface Props {
  size?: 'header' | 'hero';
  text?: string;
  /** The hero wordmark is the page's h1 (the name is what people search for); the header's is not. */
  as?: 'span' | 'h1';
}
const { size = 'header', text = site.name, as: Tag = 'span' } = Astro.props;

// The dot must always render immediately after the last word: split it off into its own
// non-wrapping unit so it can never land on its own line, detached from the name, when the
// wordmark wraps at narrow widths.
const words = text.trim().split(/\s+/);
const lastWord = words.pop() ?? text;
const leading = words.length ? `${words.join(' ')} ` : '';
---

{/* The hero wordmark is decoration on the page it names, not a link back to itself — only the
   header wordmark navigates home. */}
<Tag class:list={['logo', size]}>
  {leading && (
    size === 'hero' ? (
      <span class="wordmark lead">{leading}</span>
    ) : (
      <a href="/" class="wordmark lead" aria-hidden="true" tabindex="-1">{leading}</a>
    )
  )}<span class="tail">{size === 'hero' ? (
    <span class="wordmark">{lastWord}</span>
  ) : (
    <a href="/" class="wordmark" aria-label={`${site.name} home`}>{lastWord}</a>
  )}<button
    type="button"
    class="dot"
    data-terminal-open
    aria-label="Open terminal"
  ></button></span>
</Tag>

<style>
  .logo {
    position: relative;
    display: inline;
    line-height: 1;
  }

  /* As the h1, the wordmark must not pick up heading type or margins from global styles. */
  h1.logo {
    margin: 0;
    font: inherit;
    line-height: 1;
    letter-spacing: inherit;
    text-wrap: wrap;
  }

  .tail {
    white-space: nowrap;
  }

  .wordmark {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--stretch-display);
    font-weight: 900;
    color: var(--fg);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  /* The period is drawn, not typed: Archivo's full-weight full stop is a square,
     and the motif is a circle. Sized in em so it tracks the wordmark at any scale. */
  .dot {
    display: inline-block;
    vertical-align: baseline;
    width: 0.19em;
    height: 0.19em;
    margin-left: 0.06em;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--signal);
    cursor: pointer;
    /* a shade above the trough the status dots use: this is the brand mark and
       should never read as faded */
    --pulse-trough: 0.55;
    animation: pulse 2.4s ease-in-out infinite;
    transition: transform var(--dur) var(--ease-out);
  }

  .dot:hover,
  .dot:focus-visible {
    transform: scale(1.35);
  }

  .header .wordmark,
  .header .dot {
    font-size: var(--text-md);
  }

  .hero .wordmark,
  .hero .dot {
    font-size: var(--text-3xl);
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
</style>
