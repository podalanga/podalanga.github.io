---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Lightbox from './Lightbox.astro';
import { loopEmbedUrl, youtubeId } from '../lib/youtube';

interface ImageFigure {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface VideoFigure {
  video: string;
  caption: string;
}

export type CarouselFigure = ImageFigure | VideoFigure;

interface Props {
  id: string;
  figures: CarouselFigure[];
}

const { id, figures } = Astro.props;
const single = figures.length <= 1;

const isVideo = (figure: CarouselFigure): figure is VideoFigure => 'video' in figure;

// The lightbox only shows images, so each image slide remembers its position among them.
const images = figures.filter((f): f is ImageFigure => !isVideo(f));
let imageCount = 0;
const slides = figures.map((figure) =>
  isVideo(figure) ? { figure, imageIndex: -1 } : { figure, imageIndex: imageCount++ },
);

/** Embed URL of a video slide: muted, looping, with controls so a visitor can unmute. */
const embedOf = (figure: VideoFigure) => {
  const id = youtubeId(figure.video);
  return id ? loopEmbedUrl(id) : null;
};
---

<section class="carousel" data-carousel id={id} aria-roledescription="carousel">
  {
    slides.map(({ figure, imageIndex }, i) => (
      <figure
        class:list={['slide', { 'slide--video': isVideo(figure) }]}
        data-index={i}
        data-image-index={imageIndex}
      >
        <div class="frame">
          {isVideo(figure) ? (
            // The first slide plays on page load; later videos load when first shown.
            <iframe
              class="video"
              src={i === 0 ? embedOf(figure) : undefined}
              data-src={embedOf(figure)}
              title={figure.caption}
              allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
            />
          ) : (
            <Image
              src={figure.src}
              alt={figure.alt}
              widths={[400, 800, 1200]}
              sizes="(min-width: 780px) 50vw, 100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          )}
          {
            !single && (
              <>
                <button type="button" class="zone zone--prev" data-action="prev">
                  <span class="sr-only">Previous slide</span>
                </button>
                {!isVideo(figure) && images.length > 0 && (
                  <button type="button" class="zone zone--mid" data-action="open">
                    <span class="sr-only">View full size</span>
                  </button>
                )}
                <button type="button" class="zone zone--next" data-action="next">
                  <span class="sr-only">Next slide</span>
                </button>
              </>
            )
          }
        </div>
        {figure.caption && (
          <figcaption class="caption mono">
            {isVideo(figure) && <span class="badge">VIDEO</span>}
            {figure.caption}
          </figcaption>
        )}
        {
          !single && (
            <p class="counter mono">
              {`${String(i + 1).padStart(2, '0')} / ${String(figures.length).padStart(2, '0')}`}
            </p>
          )
        }
      </figure>
    ))
  }
  <p class="sr-only" data-live aria-live="polite" />
</section>

{!single && images.length > 0 && <Lightbox id={id} figures={images} />}

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .slide {
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-sunken);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Videos sit letterboxed in the same 4:3 frame as the images. */
  .slide--video .frame {
    display: flex;
    align-items: center;
  }

  .video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  /* Side zones on a video slide stay narrow so the player's own controls remain reachable. */
  .slide--video .zone--prev,
  .slide--video .zone--next {
    width: 12%;
    top: 20%;
    bottom: 20%;
  }

  .badge {
    margin-right: var(--space-2);
    color: var(--signal);
  }

  .caption {
    display: block;
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    letter-spacing: var(--tracking-wide);
  }

  .counter {
    padding-top: var(--space-1);
    font-size: var(--text-xs);
    color: var(--fg-subtle);
  }

  .zone {
    position: absolute;
    top: 0;
    bottom: 0;
    display: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
  }

  /* Zones only become interactive once JS has wired them up; otherwise
     they would sit as inert, unlabelled overlays for no-JS/AT users. */
  [data-carousel-ready] .zone {
    display: block;
  }

  .zone--prev {
    left: 0;
    width: 30%;
  }

  .zone--mid {
    left: 30%;
    width: 40%;
    cursor: zoom-in;
  }

  .zone--next {
    right: 0;
    width: 30%;
  }

  .zone--prev::after,
  .zone--next::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0;
    height: 0;
    opacity: 0.55;
    transition: opacity var(--dur-fast) var(--ease-out);
    border-top: 0.5rem solid transparent;
    border-bottom: 0.5rem solid transparent;
  }

  .zone--prev::after {
    left: var(--space-4);
    transform: translateY(-50%);
    border-right: 0.65rem solid var(--fg);
  }

  .zone--next::after {
    right: var(--space-4);
    transform: translateY(-50%);
    border-left: 0.65rem solid var(--fg);
  }

  .zone--prev::before,
  .zone--next::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--space-8);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .zone--prev::before {
    left: 0;
    background: linear-gradient(to right, color-mix(in srgb, var(--bg) 55%, transparent), transparent);
  }

  .zone--next::before {
    right: 0;
    background: linear-gradient(to left, color-mix(in srgb, var(--bg) 55%, transparent), transparent);
  }

  @media (hover: hover) {
    .zone--prev:hover::after,
    .zone--next:hover::after,
    .zone--prev:focus-visible::after,
    .zone--next:focus-visible::after {
      opacity: 1;
    }

    .zone--prev:hover::before,
    .zone--next:hover::before,
    .zone--prev:focus-visible::before,
    .zone--next:focus-visible::before {
      opacity: 1;
    }
  }

  .zone:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: -2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { prefersReducedMotion } from '../lib/reduced-motion';

  function initCarousel(root: HTMLElement) {
    const id = root.id;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));

    // With reduced motion the videos still load, but wait for the visitor to press play.
    const reduced = prefersReducedMotion();
    if (reduced) {
      root.querySelectorAll<HTMLIFrameElement>('iframe.video').forEach((frame) => {
        const hold = (url: string) => url.replace('autoplay=1', 'autoplay=0');
        if (frame.dataset.src) frame.dataset.src = hold(frame.dataset.src);
        const src = frame.getAttribute('src');
        if (src) frame.src = hold(src);
      });
    }

    if (slides.length <= 1) return;

    const live = root.querySelector<HTMLElement>('[data-live]');
    let current = 0;
    let stopped = false;
    let timer: number | undefined;

    function pauseVideos() {
      root.querySelectorAll<HTMLIFrameElement>('iframe.video').forEach((frame) => {
        frame.contentWindow?.postMessage(
          JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] }),
          '*',
        );
      });
    }

    /** Starts the current slide's video: loads it the first time, resumes it after that. */
    function playCurrentVideo() {
      const frame = slides[current].querySelector<HTMLIFrameElement>('iframe.video');
      if (!frame) return;
      if (!frame.getAttribute('src') && frame.dataset.src) {
        frame.src = frame.dataset.src;
        return;
      }
      if (reduced) return;
      frame.contentWindow?.postMessage(
        JSON.stringify({ event: 'command', func: 'playVideo', args: [] }),
        '*',
      );
    }

    function render() {
      pauseVideos();
      slides.forEach((slide, i) => {
        slide.hidden = i !== current;
      });
      playCurrentVideo();
      if (live) {
        const caption = slides[current].querySelector('.caption')?.textContent ?? '';
        live.textContent = `Slide ${current + 1} of ${slides.length}. ${caption}`;
      }
    }

    function go(delta: number) {
      current = (current + delta + slides.length) % slides.length;
      render();
    }

    function stopAutoplay() {
      if (stopped) return;
      stopped = true;
      if (timer) window.clearInterval(timer);
      timer = undefined;
    }

    function startAutoplay() {
      if (stopped || prefersReducedMotion() || timer) return;
      // A looping video holds the carousel; rotation only moves on from images.
      timer = window.setInterval(() => {
        if (!slides[current].classList.contains('slide--video')) go(1);
      }, 6000);
    }

    root.querySelectorAll<HTMLButtonElement>('.zone').forEach((zone) => {
      zone.addEventListener('click', () => {
        stopAutoplay();
        const action = zone.dataset.action;
        if (action === 'prev') go(-1);
        if (action === 'next') go(1);
        if (action === 'open') {
          const index = Number(slides[current].dataset.imageIndex);
          if (index >= 0) {
            window.dispatchEvent(new CustomEvent('lightbox:open', { detail: { id, index } }));
          }
        }
      });
    });

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        stopAutoplay();
        go(-1);
      }
      if (e.key === 'ArrowRight') {
        stopAutoplay();
        go(1);
      }
    });

    root.addEventListener('focusin', stopAutoplay);

    let touchStartX = 0;
    root.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].clientX;
    });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 50) {
        stopAutoplay();
        go(dx > 0 ? -1 : 1);
      }
    });

    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting && document.visibilityState === 'visible') {
          startAutoplay();
        } else if (timer) {
          window.clearInterval(timer);
          timer = undefined;
        }
      }
    });
    io.observe(root);

    document.addEventListener('visibilitychange', () => {
      if (stopped) return;
      if (document.visibilityState === 'visible') {
        startAutoplay();
      } else if (timer) {
        window.clearInterval(timer);
        timer = undefined;
      }
    });

    root.setAttribute('data-carousel-ready', '');
    render();
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
