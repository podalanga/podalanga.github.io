---
// A post in a list. Every post gets the same card: the cover in a fixed 16:9 frame, then the
// series, title, summary, date and reading time, and tags. The whole card is the link.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Tag from './Tag.astro';
import { formatDateLong } from '../lib/dates';
import { IMAGE_QUALITY } from '../lib/images';
import { readingStats } from '../lib/reading';

interface Props {
  post: CollectionEntry<'log'>;
  /** Load the cover eagerly: set on the first cards, which are on screen at load. */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { data } = post;
const href = `/blog/${post.id}/`;
const { minutes } = readingStats(post.body ?? '');
---

<article class="post-card">
  <a class="cover" href={href} tabindex="-1" aria-hidden="true">
    {
      data.cover ? (
        <Image
          src={data.cover}
          alt=""
          widths={[400, 640, 960]}
          sizes="(min-width: 900px) 40vw, 100vw"
          quality={IMAGE_QUALITY}
          loading={eager ? 'eager' : 'lazy'}
        />
      ) : (
        <span class="no-cover mono">podalanga</span>
      )
    }
  </a>
  <div class="text">
    {data.series && <p class="series mono">{data.series.title}, part {data.series.part}</p>}
    <h2 class="title"><a href={href}>{data.title}</a></h2>
    <p class="description">{data.description}</p>
    <p class="meta mono">
      <time datetime={data.date.toISOString()}>{formatDateLong(data.date)}</time>
      <span>{minutes} min read</span>
    </p>
    {
      data.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {data.tags.map((tag) => (
            <li>
              <Tag label={tag} href={`/blog/tag/${tag}/`} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    background: var(--bg-raised);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .post-card:hover,
  .post-card:focus-within {
    border-color: var(--signal);
  }

  /* The cover on a white plate in a fixed frame, so every card is the same shape whatever the
     image's proportions; diagrams are contained, never cropped. */
  .cover {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }

  /* Taken out of flow, so the frame's 16:9 decides its height, never the image's proportions. */
  .cover :global(img) {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    width: calc(100% - 2 * var(--space-3));
    height: calc(100% - 2 * var(--space-3));
    object-fit: contain;
  }

  .no-cover {
    font-size: var(--text-sm);
    color: #8a8783;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    padding: var(--space-5);
  }

  .series {
    font-size: var(--text-xs);
    color: var(--signal);
  }

  .title {
    font-size: var(--text-lg);
    font-variation-settings: 'wdth' var(--stretch-display);
    line-height: 1.1;
    text-wrap: balance;
  }

  .title a {
    color: var(--fg);
    text-decoration: none;
  }

  /* The whole card is the title's link target. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .title a:focus-visible {
    outline: none;
  }

  .post-card:has(.title a:focus-visible) {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }

  .description {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--fg-muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .tags {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
