---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatRange } from '../lib/dates';
import { DOCUMENT_KINDS, DOCUMENT_LABEL, type DocumentKind } from '../lib/documents';
import { loopEmbedUrl, youtubeId } from '../lib/youtube';

interface Props {
  slug: string;
  fileNo: number;
  codename: string;
  title: string;
  org: string;
  start: Date;
  end?: Date;
  status: 'ongoing' | 'completed';
  kind: 'internship' | 'project' | 'competition' | 'hobby';
  summary: string;
  tags: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
  variant?: 'grid' | 'row' | 'feature';
  /** Kinds of documents on file; reports and guides are flagged on the card. */
  documentKinds?: DocumentKind[];
  /** A YouTube URL; when set it plays muted and looping in place of the cover. */
  video?: string;
}

const {
  slug,
  fileNo,
  codename,
  title,
  org,
  start,
  end,
  status,
  kind,
  summary,
  tags,
  cover,
  coverAlt,
  variant = 'grid',
  documentKinds = [],
  video,
} = Astro.props;

const videoId = video ? youtubeId(video) : null;
const videoSrc = videoId ? loopEmbedUrl(videoId, { controls: false }) : null;

const fileLabel = `FILE ${String(fileNo).padStart(2, '0')}`;
const docFlags = DOCUMENT_KINDS.filter((k) => k !== 'other' && documentKinds.includes(k)).map(
  (k) => DOCUMENT_LABEL[k],
);
---

<a href={`/projects/${slug}/`} class:list={['case-card', variant]} data-kind={kind}>
  <div class="text">
    <div class="top mono">
      <span class="file" transition:name={`file-${slug}`}>{fileLabel} // {codename}</span>
      <span class="status" class:list={{ ongoing: status === 'ongoing' }}>
        <span class="dot" aria-hidden="true"></span>
        {status === 'ongoing' ? 'ONGOING' : 'CLOSED'}
      </span>
    </div>

    <h3 class="title" transition:name={`title-${slug}`}>{title}</h3>
    <p class="org mono">{org} · {formatRange(start, end, status)}</p>
    <p class="summary">{summary}</p>

    <ul class="tags mono">
      {tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
    </ul>

    {
      docFlags.length > 0 && (
        <p class="docs mono">
          <span class="docs-lead">
            <span class="docs-mark" aria-hidden="true">▤</span>
            ON FILE<span class="sr-only">:</span>
          </span>
          {docFlags.map((flag) => (
            <span class="docs-chip">{flag}</span>
          ))}
        </p>
      )
    }
  </div>

  {
    cover || videoSrc ? (
      <div class="thumb">
        {cover && (
          <Image src={cover} alt={coverAlt ?? title} widths={[320, 640, 960]} sizes="(min-width: 780px) 40vw, 100vw" />
        )}
        {videoSrc && (
          // Decorative: the card stays one link, so the player takes no clicks or focus.
          <iframe
            class="thumb-video"
            src={videoSrc}
            title={`${title}: video`}
            loading="lazy"
            tabindex="-1"
            aria-hidden="true"
            allow="autoplay; encrypted-media"
            referrerpolicy="strict-origin-when-cross-origin"
          />
        )}
      </div>
    ) : (
      <div class="thumb placeholder" aria-hidden="true" />
    )
  }
</a>

<style>
  .case-card {
    height: 100%;
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--line);
    background: var(--bg-raised);
    text-decoration: none;
    color: var(--fg);
    transition: border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .case-card:hover {
    border-color: var(--line-strong);
    background: var(--surface-hover);
  }

  /* The file number is the card's signal: it lights, the whole card does not. */
  .case-card:hover .file {
    color: var(--signal);
  }

  .file {
    transition: color var(--dur) var(--ease-out);
  }

  .case-card.row {
    padding: var(--space-5) 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
  }

  .case-card.row:hover {
    background: none;
    border-color: var(--line-strong);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    min-width: 0;
  }

  .thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line);
    flex-shrink: 0;
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) sepia(0.08);
    transition: filter var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }

  .thumb {
    position: relative;
  }

  /* Covers the 16:10 frame like the image does: a 16:9 video at full height is 10/9 of the
     frame's width, so it is centred and its sides are cropped. */
  .thumb-video {
    position: absolute;
    top: 0;
    left: 50%;
    width: calc(100% * 10 / 9);
    height: 100%;
    transform: translateX(-50%);
    border: 0;
    pointer-events: none;
    background: var(--bg-sunken);
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb-video {
      display: none;
    }
  }

  /* A file with no cover holds its space but draws nothing: no frame, no fill,
     just the room the image would have taken. It still stretches, so the card
     ends level with a neighbour that does have an image. */
  .thumb.placeholder {
    aspect-ratio: auto;
    flex: 1 1 auto;
    min-height: var(--space-10);
    border: 0;
    background: none;
  }

  @media (hover: hover) {
    .case-card:hover .thumb :global(img) {
      filter: none;
      transform: scale(1.03);
    }
  }

  @media (min-width: 640px) {
    .case-card:not(.feature) {
      flex-direction: row;
      align-items: center;
    }

    .case-card:not(.feature) .thumb {
      width: 40%;
      aspect-ratio: 16 / 10;
      order: 2;
    }

    .text {
      order: 1;
    }
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--fg-muted);
  }

  .docs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--signal);
  }

  .docs-lead {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .docs-chip {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--signal-dim);
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .status .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg-muted);
  }

  .status.ongoing .dot {
    background: var(--signal);
    --pulse-trough: 0.25;
    animation: pulse 2.4s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .status.ongoing .dot {
      animation: none;
    }
  }

  .title {
    font-size: var(--text-md);
  }

  /* One card per group leads: bigger title, image above the fold of the card. */
  .case-card.feature {
    flex-direction: column-reverse;
  }

  .case-card.feature .title {
    font-size: var(--text-lg);
  }

  .case-card.feature .thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .org {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    letter-spacing: var(--tracking-wide);
  }

  .summary {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .tags li {
    border: 1px solid var(--line);
    padding: var(--space-1) var(--space-2);
  }
</style>
