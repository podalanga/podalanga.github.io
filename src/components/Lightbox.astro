---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Figure {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  id: string;
  figures: Figure[];
}

const { id, figures } = Astro.props;

const fullSize = await Promise.all(
  figures.map((figure) => getImage({ src: figure.src, width: 2000 }))
);
---

<dialog id={`lightbox-${id}`} class="lightbox" aria-label="Image viewer">
  <button type="button" class="close mono" data-action="close" aria-label="Close">✕</button>
  <button type="button" class="nav prev mono" data-action="prev" aria-label="Previous image">‹</button>
  <img class="lightbox-img" alt="" />
  <button type="button" class="nav next mono" data-action="next" aria-label="Next image">›</button>
  <p class="lightbox-caption mono"></p>
</dialog>

<script type="application/json" data-lightbox-data={id} is:inline set:html={JSON.stringify(
  fullSize.map((img, i) => ({ src: img.src, alt: figures[i].alt, caption: figures[i].caption ?? '' }))
)} />

<style>
  .lightbox {
    display: none;
  }

  .lightbox[open] {
    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: var(--space-5);
    border: 0;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    animation: lightbox-in var(--dur) var(--ease-out);
    display: grid;
    grid-template-rows: 1fr auto;
    justify-content: center;
    align-items: center;
  }

  .lightbox::backdrop {
    background: var(--scrim);
    animation: lightbox-fade var(--dur) var(--ease-out);
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.99);
    }
  }

  @keyframes lightbox-fade {
    from {
      opacity: 0;
    }
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 80vh;
    margin-inline: auto;
    object-fit: contain;
  }

  .lightbox-caption {
    text-align: center;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    padding-top: var(--space-3);
  }

  .lightbox .close,
  .lightbox .nav {
    position: fixed;
    background: none;
    border: 1px solid var(--line);
    color: var(--fg);
    width: 2.5rem;
    height: 2.5rem;
    font-size: var(--text-md);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .lightbox .close {
    top: var(--space-5);
    right: var(--space-5);
  }

  .lightbox .nav.prev {
    left: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox .nav.next {
    right: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox .close:hover,
  .lightbox .nav:hover {
    border-color: var(--signal);
    color: var(--signal);
  }
</style>

<script>
  interface LightboxItem {
    src: string;
    alt: string;
    caption: string;
  }

  interface OpenLightboxDetail {
    id: string;
    index: number;
  }

  function initLightbox(dialog: HTMLDialogElement) {
    const id = dialog.id.replace(/^lightbox-/, '');
    const dataEl = document.querySelector(`script[data-lightbox-data="${id}"]`);
    if (!dataEl) return;

    const items: LightboxItem[] = JSON.parse(dataEl.textContent || '[]');
    const img = dialog.querySelector('.lightbox-img') as HTMLImageElement;
    const caption = dialog.querySelector('.lightbox-caption') as HTMLElement;
    let current = 0;

    function show(index: number) {
      current = (index + items.length) % items.length;
      const item = items[current];
      img.src = item.src;
      img.alt = item.alt;
      caption.textContent = item.caption;
    }

    function open(index: number) {
      show(index);
      dialog.showModal();
    }

    dialog.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).dataset.action;
      if (action === 'close') dialog.close();
      if (action === 'prev') show(current - 1);
      if (action === 'next') show(current + 1);
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    let touchStartX = 0;
    dialog.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].clientX;
    });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (dx > 50) show(current - 1);
      if (dx < -50) show(current + 1);
    });

    window.addEventListener('lightbox:open', (e) => {
      const detail = (e as CustomEvent<OpenLightboxDetail>).detail;
      if (detail?.id === id) open(detail.index);
    });
  }

  function init() {
    document.querySelectorAll<HTMLDialogElement>('dialog[id^="lightbox-"]').forEach(initLightbox);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
