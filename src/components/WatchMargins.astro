---
// A glyph column down each edge of the screen that grows with scroll progress and stops above the
// footer (watch-margins.ts): noise, a line from 1984 when one is showing, more noise, and a blinking
// dot at the reader's place.
---

<div class="watch-margins" data-watch-margins aria-hidden="true">
  <span class="column left" data-watch-column><span class="before"></span><span class="said"></span><span class="after"></span><span class="head"></span></span>
  <span class="column right" data-watch-column><span class="before"></span><span class="said"></span><span class="after"></span><span class="head"></span></span>
</div>

<style>
  .watch-margins {
    display: none;
  }

  @media (min-width: 900px) {
    .watch-margins {
      display: block;
    }
  }

  @media print {
    .watch-margins {
      display: none !important;
    }
  }

  .column {
    position: fixed;
    z-index: 30;
    top: calc(var(--header-h) + var(--space-3));
    bottom: var(--space-3);
    /* Hard against the edges of the window (the right one just inside the scrollbar). */
    --edge: 4px;
    overflow: hidden;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    writing-mode: vertical-rl;
    text-orientation: upright;
    white-space: pre;
    user-select: none;
  }

  .left {
    left: var(--edge);
  }

  .right {
    right: var(--edge);
  }

  /* Noise, a line from 1984 and the dot are all the same red; a line stands out only by holding
     still while the noise around it churns. */
  .before,
  .said,
  .after,
  .head {
    color: var(--signal);
  }

  /* The blinking dot marks the reader's place. */
  .head {
    animation: pulse 2.4s var(--ease-in-out) infinite;
    --pulse-trough: 0.35;
  }

  @media (prefers-reduced-motion: reduce) {
    .head {
      animation: none;
    }
  }
</style>
