---
// A glyph column down each edge of the screen that grows with scroll progress and stops above the
// footer (watch-margins.ts). Dim noise, a line from 1984 when one is showing, more noise, and the
// bright leading glyph.
---

<div class="watch-margins" data-watch-margins aria-hidden="true">
  <span class="column left" data-watch-column><span class="before"></span><span class="said"></span><span class="after"></span><span class="head"></span></span>
  <span class="column right" data-watch-column><span class="before"></span><span class="said"></span><span class="after"></span><span class="head"></span></span>
</div>

<style>
  .watch-margins {
    display: none;
  }

  @media (min-width: 900px) {
    .watch-margins {
      display: block;
    }
  }

  @media print {
    .watch-margins {
      display: none !important;
    }
  }

  .column {
    position: fixed;
    z-index: 30;
    top: calc(var(--header-h) + var(--space-3));
    bottom: var(--space-3);
    /* Hard against the edges of the window (the right one just inside the scrollbar). */
    --edge: 4px;
    overflow: hidden;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    writing-mode: vertical-rl;
    text-orientation: upright;
    white-space: pre;
    user-select: none;
  }

  .left {
    left: var(--edge);
  }

  .right {
    right: var(--edge);
  }

  .before,
  .after {
    color: var(--signal);
    opacity: 0.38;
  }

  .head,
  .said {
    color: var(--signal);
  }

  .said {
    text-shadow: 0 0 6px color-mix(in srgb, var(--signal) 55%, transparent);
  }
</style>
